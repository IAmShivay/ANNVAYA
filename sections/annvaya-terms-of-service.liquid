{%- style -%}
  .annvaya-legal-tos-{{ section.id }} {}
  .annvaya-legal-tos-hero-{{ section.id }} {
    background: {{ section.settings.hero_bg_color }};
    color: {{ section.settings.hero_text_color }};
    padding: {{ section.settings.hero_padding_top }}px 20px {{ section.settings.hero_padding_bottom }}px;
    text-align: center;
  }
  .annvaya-tos-eyebrow-{{ section.id }} {
    display: inline-block;
    background: rgba(212,167,106,0.18);
    color: #D4A76A;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 18px;
  }
  .annvaya-legal-tos-hero-{{ section.id }} h1 {
    font-size: clamp(1.9rem, 5vw, 2.9rem);
    font-weight: 700;
    margin: 0 0 14px;
    color: {{ section.settings.hero_text_color }};
  }
  .annvaya-legal-tos-hero-{{ section.id }} p {
    font-size: 1rem;
    opacity: 0.82;
    max-width: 540px;
    margin: 0 auto 16px;
    line-height: 1.65;
  }
  .annvaya-tos-date-{{ section.id }} { font-size: 0.78rem; opacity: 0.55; }
  .annvaya-legal-tos-body-{{ section.id }} {
    background: {{ section.settings.body_bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  .annvaya-legal-tos-inner-{{ section.id }} { max-width: 800px; margin: 0 auto; }
  .annvaya-tos-content-{{ section.id }} {
    background: #fff;
    border: 1px solid #E8E0D4;
    border-radius: 12px;
    padding: 36px 40px;
    margin-bottom: 20px;
  }
  .annvaya-tos-content-{{ section.id }} h2,
  .annvaya-tos-content-{{ section.id }} h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2D2A26;
    margin: 0 0 14px;
    padding-top: 8px;
  }
  .annvaya-tos-content-{{ section.id }} h2:first-child,
  .annvaya-tos-content-{{ section.id }} h3:first-child { padding-top: 0; }
  .annvaya-tos-content-{{ section.id }} p {
    font-size: 0.95rem;
    color: #4A4540;
    line-height: 1.72;
    margin: 0 0 12px;
  }
  .annvaya-tos-content-{{ section.id }} ul,
  .annvaya-tos-content-{{ section.id }} ol {
    padding-left: 20px;
    margin: 0 0 12px;
  }
  .annvaya-tos-content-{{ section.id }} li {
    font-size: 0.95rem;
    color: #4A4540;
    line-height: 1.68;
    margin-bottom: 6px;
  }
  .annvaya-tos-content-{{ section.id }} strong { color: #2D2A26; }
  .annvaya-tos-contact-{{ section.id }} {
    background: {{ section.settings.hero_bg_color }};
    color: {{ section.settings.hero_text_color }};
    border-radius: 12px;
    padding: 32px;
    text-align: center;
    margin-top: 8px;
  }
  .annvaya-tos-contact-{{ section.id }} h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 10px;
    color: {{ section.settings.hero_text_color }};
  }
  .annvaya-tos-contact-{{ section.id }} p {
    font-size: 0.94rem;
    opacity: 0.82;
    margin: 0 0 18px;
    line-height: 1.6;
  }
  .annvaya-tos-contact-btn-{{ section.id }} {
    display: inline-block;
    background: #D4A76A;
    color: #2D2A26;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 28px;
    border-radius: 40px;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .annvaya-tos-content-{{ section.id }} { padding: 22px 18px; }
    .annvaya-tos-contact-{{ section.id }} { padding: 24px 18px; }
  }
{%- endstyle -%}

<section class="annvaya-legal-tos-{{ section.id }}">

  <div class="annvaya-legal-tos-hero-{{ section.id }}">
    {%- unless section.settings.eyebrow == blank -%}
      <div class="annvaya-tos-eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</div>
    {%- endunless -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- unless section.settings.subheading == blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endunless -%}
    {%- unless section.settings.last_updated == blank -%}
      <div class="annvaya-tos-date-{{ section.id }}">{{ section.settings.last_updated }}</div>
    {%- endunless -%}
  </div>

  <div class="annvaya-legal-tos-body-{{ section.id }}">
    <div class="annvaya-legal-tos-inner-{{ section.id }}">

      <div class="annvaya-tos-content-{{ section.id }}">
        {{ page.content }}
      </div>

      {%- if section.settings.show_contact -%}
        <div class="annvaya-tos-contact-{{ section.id }}">
          <h2>{{ section.settings.contact_heading }}</h2>
          <p>{{ section.settings.contact_subtext }}</p>
          <a href="mailto:{{ section.settings.contact_email }}" class="annvaya-tos-contact-btn-{{ section.id }}">
            {{ section.settings.contact_email }}
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Terms of Service Page",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Legal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Terms of Service"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Please read these terms carefully before placing an order with AnnVaya."
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated text",
      "default": "Last updated: August 2026"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Hero background colour",
      "default": "#4A5740"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero text colour",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "hero_padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Hero padding top (px)"
    },
    {
      "type": "range",
      "id": "hero_padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 48,
      "label": "Hero padding bottom (px)"
    },
    {
      "type": "header",
      "content": "Body"
    },
    {
      "type": "color",
      "id": "body_bg_color",
      "label": "Body background colour",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 52,
      "label": "Body padding top (px)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "label": "Body padding bottom (px)"
    },
    {
      "type": "header",
      "content": "Contact block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Questions about our terms?"
    },
    {
      "type": "text",
      "id": "contact_subtext",
      "label": "Contact subtext",
      "default": "Email us and we will respond within 2 business days."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "support@annvaya.com"
    }
  ],
  "presets": [
    { "name": "Terms of Service Page" }
  ]
}
{% endschema %}
