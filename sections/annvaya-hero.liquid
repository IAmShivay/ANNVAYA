</section>

{%- comment -%} ═══════════ V5: SPLIT HERO ═══════════ {%- endcomment -%}
{%- elsif variant == 'split-hero' -%}
<section class="avh-{{ section.id }} avh--v5-{{ section.id }}" id="AnnvayaHero-{{ section.id }}" aria-label="{{ heading_text | default: 'AnnVaya Hero' | strip_html | truncate: 60 }}">
  <div class="avh__v5-left">
    <div class="avh__v5-left-inner">
      {{ eyebrow_html }}
      {{ heading_html }}
      {%- if tagline != blank -%}
