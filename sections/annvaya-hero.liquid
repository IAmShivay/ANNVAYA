      <button class="avh__nav-btn avh__v5-next" aria-label="Next"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    {%- assign v5_total = 0 -%}
    {%- if hero_img != blank -%}{%- assign v5_total = 1 -%}{%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' and block.settings.slide_image != blank -%}{%- assign v5_total = v5_total | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if v5_total > 1 -%}
