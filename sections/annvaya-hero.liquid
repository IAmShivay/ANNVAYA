      {%- endif -%}
      {{ sub_html }}
      {{ trust_badges }}
      {{ cta_html }}
    </div>
  </div>
  <div class="avh__v5-right">
    {%- assign v5_slide_index = 0 -%}
    {%- if hero_img != blank -%}
      <div class="avh__v5-slide active" data-slide="0">
        <img src="{{ hero_img }}" alt="{{ hero_img_alt }}" width="{{ img_width }}" height="{{ img_height }}" loading="eager" fetchpriority="high" decoding="async" sizes="50vw">
      </div>
      {%- assign v5_slide_index = 1 -%}
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' and block.settings.slide_image != blank -%}
        <div class="avh__v5-slide{% if v5_slide_index == 0 %} active{% endif %}" data-slide="{{ v5_slide_index }}" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.slide_image | image_url: width: 1200 }}" alt="{{ block.settings.slide_image.alt | escape | default: 'AnnVaya' }}" loading="lazy" decoding="async" sizes="50vw">
        </div>
        {%- assign v5_slide_index = v5_slide_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if hero_img == blank -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#4A7358,#2E3B33);"></div>
