    <div class="avh__v1-image">
      {%- if hero_img != blank -%}
        <img src="{{ hero_img }}" alt="{{ hero_img_alt }}" width="{{ img_width }}" height="{{ img_height }}" loading="eager" fetchpriority="high" decoding="async">
      {%- else -%}
        <div style="width:360px;height:420px;background:linear-gradient(135deg,#4A7358,#2E3B33);border-radius:16px;"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} ═══════════ V2: BENEFIT FIRST ═══════════ {%- endcomment -%}
{%- elsif variant == 'benefit-first' -%}
<section class="avh-{{ section.id }} avh--v2-{{ section.id }}" id="AnnvayaHero-{{ section.id }}" aria-label="{{ heading_text | default: 'AnnVaya Hero' | strip_html | truncate: 60 }}">
  <div class="avh__media" aria-hidden="true">
    {%- if hero_img != blank -%}
      <img src="{{ hero_img }}" alt="{{ hero_img_alt }}" width="{{ img_width }}" height="{{ img_height }}" loading="eager" fetchpriority="high" decoding="async" sizes="100vw">
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#4A7358,#2E3B33);"></div>
    {%- endif -%}
    <div class="avh__gradient"></div>
    {{ wave_svg }}
  </div>
  <div class="avh__outer">
    <div class="avh__inner">
      {{ eyebrow_html }}
      {{ heading_html }}
      {{ sub_html }}
      {{ trust_badges }}
      {{ cta_html }}
    </div>
  </div>
</section>

{%- comment -%} ═══════════ V3: SLIDER CAROUSEL ═══════════ {%- endcomment -%}
{%- elsif variant == 'slider-carousel' -%}
<section class="avh-{{ section.id }} avh--v3-{{ section.id }}" id="AnnvayaHero-{{ section.id }}" aria-label="{{ heading_text | default: 'AnnVaya Hero' | strip_html | truncate: 60 }}">
  <div class="avh__media" aria-hidden="true">
    {%- assign slide_index = 0 -%}
    {%- if hero_img != blank -%}
      <div class="avh__slide active" data-slide="0">
        <img src="{{ hero_img }}" alt="{{ hero_img_alt }}" width="{{ img_width }}" height="{{ img_height }}" loading="eager" fetchpriority="high" decoding="async" sizes="100vw">
      </div>
      {%- assign slide_index = 1 -%}
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' and block.settings.slide_image != blank -%}
        <div class="avh__slide{% if slide_index == 0 %} active{% endif %}" data-slide="{{ slide_index }}" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.slide_image | image_url: width: 2400 }}" alt="{{ block.settings.slide_image.alt | escape | default: 'AnnVaya Slide' }}" width="{{ block.settings.slide_image.width }}" height="{{ block.settings.slide_image.width | divided_by: block.settings.slide_image.aspect_ratio | round }}" loading="lazy" decoding="async" sizes="100vw">
        </div>
        {%- assign slide_index = slide_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    <div class="avh__gradient"></div>
    {{ wave_svg }}
  </div>
  <div class="avh__nav">
    <button class="avh__nav-btn avh__nav-prev" aria-label="Previous slide"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="avh__nav-btn avh__nav-next" aria-label="Next slide"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
  <div class="avh__outer">
    <div class="avh__inner">
      {{ eyebrow_html }}
      {{ heading_html }}
      {{ sub_html }}
      {{ trust_badges }}
      {{ cta_html }}
      <div class="avh__dots">
        {%- assign total_slides = 0 -%}
        {%- if hero_img != blank -%}{%- assign total_slides = 1 -%}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' and block.settings.slide_image != blank -%}
            {%- assign total_slides = total_slides | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for i in (1..total_slides) -%}
          {%- assign dot_index = i | minus: 1 -%}
          <button class="avh__dot{% if dot_index == 0 %} active{% endif %}" data-dot="{{ dot_index }}" aria-label="Go to slide {{ i }}"></button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ═══════════ V4: STORY + TRUST ═══════════ {%- endcomment -%}
{%- elsif variant == 'story-trust' -%}
<section class="avh-{{ section.id }} avh--v4-{{ section.id }}" id="AnnvayaHero-{{ section.id }}" aria-label="{{ heading_text | default: 'AnnVaya Hero' | strip_html | truncate: 60 }}">
