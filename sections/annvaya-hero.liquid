      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{%- comment -%} ── Carousel JS for V3 and V5 ── {%- endcomment -%}
{%- if variant == 'slider-carousel' -%}
<script>
(function(){
  var s=document.getElementById('AnnvayaHero-{{ section.id }}');if(!s)return;
  var slides=s.querySelectorAll('.avh__slide'),dots=s.querySelectorAll('.avh__dot'),
      prev=s.querySelector('.avh__nav-prev'),next=s.querySelector('.avh__nav-next');
  if(slides.length<2)return;var c=0,t=slides.length,iv={{ section.settings.autoplay_speed | default: 5 }}*1000,tm;
  function go(i){slides[c].classList.remove('active');if(dots[c])dots[c].classList.remove('active');
    c=((i%t)+t)%t;slides[c].classList.add('active');if(dots[c])dots[c].classList.add('active');}
  function start(){stop();tm=setInterval(function(){go(c+1)},iv);}function stop(){clearInterval(tm);}
  if(next)next.onclick=function(){stop();go(c+1);start();};
  if(prev)prev.onclick=function(){stop();go(c-1);start();};
  dots.forEach(function(d){d.onclick=function(){stop();go(+d.dataset.dot);start();};});
  start();
})();
</script>
{%- endif -%}

{%- if variant == 'split-hero' -%}
<script>
(function(){
  var s=document.getElementById('AnnvayaHero-{{ section.id }}');if(!s)return;
  var slides=s.querySelectorAll('.avh__v5-slide'),dots=s.querySelectorAll('.avh__v5-dots .avh__dot'),
      prev=s.querySelector('.avh__v5-prev'),next=s.querySelector('.avh__v5-next');
  if(slides.length<2)return;var c=0,t=slides.length,iv={{ section.settings.autoplay_speed | default: 5 }}*1000,tm;
  function go(i){slides[c].classList.remove('active');if(dots[c])dots[c].classList.remove('active');
    c=((i%t)+t)%t;slides[c].classList.add('active');if(dots[c])dots[c].classList.add('active');}
  function start(){stop();tm=setInterval(function(){go(c+1)},iv);}function stop(){clearInterval(tm);}
  if(next)next.onclick=function(){stop();go(c+1);start();};
  if(prev)prev.onclick=function(){stop();go(c-1);start();};
  dots.forEach(function(d){d.onclick=function(){stop();go(+d.dataset.dot);start();};});
  start();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "AnnVaya Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Hero variant",
      "info": "Each variant has a completely different layout.",
      "options": [
        { "value": "product-first",    "label": "V1 \u2014 Product First (Clean & Bold)" },
        { "value": "benefit-first",    "label": "V2 \u2014 Benefit First (Lifestyle Focus)" },
        { "value": "slider-carousel",  "label": "V3 \u2014 Slider Carousel (Multiple Slides)" },
        { "value": "story-trust",      "label": "V4 \u2014 Story + Trust (Editorial Minimal)" },
        { "value": "split-hero",       "label": "V5 \u2014 Split Hero (Scroll Tease)" }
      ],
      "default": "benefit-first"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "left top",      "label": "Left top" },
        { "value": "left center",   "label": "Left center" },
        { "value": "center center", "label": "Center" },
        { "value": "right center",  "label": "Right center" },
        { "value": "right top",     "label": "Right top" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "info": "V4: try REAL INGREDIENTS. LASTING WELLNESS. Leave blank for default trust line."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "info": "V1: Goodness you can feel. V2: Daily Nutrition, Naturally. V4: The Power of Moringa. V5: From Nature\u2019s Fields to Your Family\u2019s Health.",
      "default": "Nature\u2019s Goodness, <em>Made for Every Generation.</em>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (V5 only)",
      "info": "Italic accent below the headline. Example: Small Leaves. Big Benefits."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "Wholesome, naturally crafted nutrition made from real ingredients for your family\u2019s everyday wellness."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary button label",
      "default": "Shop Moringa \u2192"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary button label",
      "default": "Why Annvaya \u2192"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height (px)",
      "min": 500,
      "max": 900,
      "step": 10,
      "default": 700
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Carousel speed (seconds, V3/V5)",
      "min": 3,
      "max": 10,
