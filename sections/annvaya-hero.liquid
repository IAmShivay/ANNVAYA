      <div style="width:100%;height:100%;background:linear-gradient(135deg,#4A7358,#2E3B33);"></div>
    {%- endif -%}
    <div class="avh__gradient"></div>
    {{ wave_svg }}
  </div>
  <div class="avh__outer">
