{%- comment -%}
  ANNVAYA — Homepage Blog Section
  Shows the latest N articles from the configured blog.
  Equal-column grid. Designed to sit near the bottom of the homepage.
{%- endcomment -%}

{%- liquid
  assign blog_handle = section.settings.blog | default: 'news'
  assign blog_obj    = blogs[blog_handle]
  assign show_count  = section.settings.articles_to_show | default: 3
  assign prefix      = 'ahb-' | append: section.id
-%}

{%- if blog_obj == blank or blog_obj.articles_count == 0 -%}
  {%- if request.design_mode -%}
    <div style="padding:40px;text-align:center;background:#F5F2EB;color:#9B8B7A;font-family:sans-serif;">
      Homepage Blog section: no articles published yet — add posts to the <strong>{{ blog_handle }}</strong> blog.
    </div>
  {%- endif -%}
{%- else -%}

{%- style -%}
/* ─── ANNVAYA HOMEPAGE BLOG ────────────────────────────────── */
.{{ prefix }} {
  background: {{ section.settings.bg_color | default: '#2C2416' }};
  padding: {{ section.settings.padding_top | default: 72 }}px 0 {{ section.settings.padding_bottom | default: 72 }}px;
}

.{{ prefix }} .ahb__inner {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
}

.{{ prefix }} .ahb__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 44px;
}

.{{ prefix }} .ahb__eyebrow {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #C8963E;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.{{ prefix }} .ahb__eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1.5px;
  background: #C8963E;
}

.{{ prefix }} .ahb__heading {
  font-family: var(--font-heading-family);
  font-size: 36px;
  font-weight: 700;
  color: #F5F2EB;
  margin: 0;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.{{ prefix }} .ahb__subheading {
  font-family: var(--font-body-family);
  font-size: 15px;
  color: rgba(245,242,235,0.6);
  margin: 10px 0 0;
  max-width: 420px;
  line-height: 1.55;
}

.{{ prefix }} .ahb__all-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body-family);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #F5F2EB;
  text-decoration: none;
  border: 1px solid rgba(245,242,235,0.25);
  padding: 10px 20px;
  border-radius: 2px;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.2s, border-color 0.2s;
}
.{{ prefix }} .ahb__all-link:hover {
  background: rgba(245,242,235,0.08);
  border-color: rgba(245,242,235,0.5);
}

.{{ prefix }} .ahb__grid {
  display: grid;
  grid-template-columns: repeat({{ show_count }}, 1fr);
  gap: 24px;
}

/* Card */
.{{ prefix }} .ahb__card {
  display: flex;
  flex-direction: column;
  background: rgba(245,242,235,0.05);
  border: 1px solid rgba(245,242,235,0.08);
  border-radius: 4px;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
}
.{{ prefix }} .ahb__card:hover {
  transform: translateY(-4px);
  background: rgba(245,242,235,0.09);
  box-shadow: 0 12px 36px rgba(0,0,0,0.3);
}

.{{ prefix }} .ahb__card-img-wrap {
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: rgba(245,242,235,0.04);
  position: relative;
}
.{{ prefix }} .ahb__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.{{ prefix }} .ahb__card:hover .ahb__card-img { transform: scale(1.04); }

.{{ prefix }} .ahb__card-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(200,150,62,0.15), rgba(74,115,88,0.10));
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(245,242,235,0.2);
  font-size: 40px;
}

.{{ prefix }} .ahb__card-type-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
}
.{{ prefix }} .ahb__card-type-badge--recipe { background: rgba(200,150,62,0.9); color: #fff; }
.{{ prefix }} .ahb__card-type-badge--health  { background: rgba(74,115,88,0.9); color: #fff; }
.{{ prefix }} .ahb__card-type-badge--default { background: rgba(44,36,22,0.7); color: rgba(245,242,235,0.9); }

.{{ prefix }} .ahb__card-body {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.{{ prefix }} .ahb__card-meta-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.{{ prefix }} .ahb__card-tag {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #C8963E;
}

.{{ prefix }} .ahb__card-date {
  font-family: var(--font-body-family);
  font-size: 11px;
  color: rgba(245,242,235,0.35);
}

.{{ prefix }} .ahb__card-title {
  font-family: var(--font-heading-family);
  font-size: 18px;
  font-weight: 700;
  color: #F5F2EB;
  line-height: 1.3;
  margin: 0 0 10px;
  flex: 1;
}

.{{ prefix }} .ahb__card-excerpt {
  font-family: var(--font-body-family);
  font-size: 13px;
  color: rgba(245,242,235,0.55);
  line-height: 1.6;
  margin-bottom: 18px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.{{ prefix }} .ahb__card-read {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #C8963E;
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: auto;
  transition: gap 0.2s ease;
}
.{{ prefix }} .ahb__card:hover .ahb__card-read { gap: 10px; }

@media screen and (max-width: 749px) {
  .{{ prefix }} { padding: 52px 0 60px; }
  .{{ prefix }} .ahb__inner { padding: 0 1.5rem; }
  .{{ prefix }} .ahb__header { flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 28px; }
  .{{ prefix }} .ahb__heading { font-size: 26px; }
  .{{ prefix }} .ahb__grid { grid-template-columns: 1fr; gap: 16px; }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .{{ prefix }} .ahb__inner { padding: 0 5rem; }
  .{{ prefix }} .ahb__grid { grid-template-columns: repeat(2, 1fr); }
  .{{ prefix }} .ahb__heading { font-size: 30px; }
}
{%- endstyle -%}

<div class="{{ prefix }}">
  <div class="ahb__inner">
    <div class="ahb__header">
      <div class="ahb__header-left">
        <p class="ahb__eyebrow">{{ section.settings.eyebrow | default: 'From Our Kitchen & Health Journal' }}</p>
        <h2 class="ahb__heading">{{ section.settings.heading | default: 'Recipes & Wellness Reads' }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="ahb__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <a href="{{ blog_obj.url }}" class="ahb__all-link">
        All articles <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="ahb__grid">
      {%- assign display_count = 0 -%}
      {%- for article in blog_obj.articles -%}
        {%- if display_count >= show_count -%}{%- break -%}{%- endif -%}

        {%- assign badge_class = 'default' -%}
        {%- assign badge_label = '' -%}
        {%- for tag in article.tags -%}
          {%- assign tag_lower = tag | downcase -%}
          {%- if tag_lower == 'recipe' or tag_lower == 'recipes' -%}
            {%- assign badge_class = 'recipe' -%}
            {%- assign badge_label = 'Recipe' -%}
            {%- break -%}
          {%- elsif tag_lower == 'health' or tag_lower == 'wellness' or tag_lower == 'nutrition' -%}
            {%- assign badge_class = 'health' -%}
            {%- assign badge_label = 'Health' -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <a href="{{ article.url }}" class="ahb__card">
          <div class="ahb__card-img-wrap">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w"
                sizes="(max-width:749px) 90vw, (max-width:989px) 45vw, 30vw"
                alt="{{ article.image.alt | escape | default: article.title | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="lazy"
                class="ahb__card-img">
            {%- else -%}
              <div class="ahb__card-img-placeholder">🌿</div>
            {%- endif -%}
            {%- if badge_label != blank -%}
              <span class="ahb__card-type-badge ahb__card-type-badge--{{ badge_class }}">{{ badge_label }}</span>
            {%- endif -%}
          </div>
          <div class="ahb__card-body">
            <div class="ahb__card-meta-top">
              {%- if article.tags.size > 0 -%}
                <span class="ahb__card-tag">{{ article.tags.first }}</span>
              {%- endif -%}
              <span class="ahb__card-date">{{ article.published_at | date: '%b %d, %Y' }}</span>
            </div>
            <h3 class="ahb__card-title">{{ article.title | escape }}</h3>
            {%- if article.excerpt_or_content != blank -%}
              <p class="ahb__card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
            <span class="ahb__card-read">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>

        {%- assign display_count = display_count | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- endif -%}

{% schema %}
{
  "name": "Homepage Blog",
  "tag": "section",
  "class": "annvaya-homepage-blog",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "From Our Kitchen & Health Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recipes & Wellness Reads" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover how to use AnnVaya powders in everyday cooking and your wellness routine." },
    { "type": "range", "id": "articles_to_show", "min": 2, "max": 4, "step": 1, "label": "Articles to show", "default": 3 },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#2C2416" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Homepage Blog" }]
}
{% endschema %}
