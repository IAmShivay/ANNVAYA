{%- if articles_html != blank -%}

{%- style -%}
/* ─── ANNVAYA PRODUCT RECIPES ──────────────────────────────── */
.{{ prefix }} {
  background: {{ section.settings.bg_color | default: '#F5F2EB' }};
  padding: {{ section.settings.padding_top | default: 52 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px;
  border-top: 1px solid rgba(74,63,48,0.08);
}

.{{ prefix }} .apr__inner {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
}

/* ── Header ── */
.{{ prefix }} .apr__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 40px;
}

.{{ prefix }} .apr__eyebrow {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #C8963E;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.{{ prefix }} .apr__eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1.5px;
  background: #C8963E;
  flex-shrink: 0;
}

.{{ prefix }} .apr__heading {
  font-family: var(--font-heading-family);
  font-size: 30px;
  font-weight: 700;
  color: #2C2416;
  margin: 0;
  letter-spacing: -0.01em;
}

.{{ prefix }} .apr__all-link {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #4A7358;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  transition: gap 0.2s ease;
}
.{{ prefix }} .apr__all-link:hover { gap: 10px; }

/* ── Layout wrapper ── */
.{{ prefix }} .apr__layout {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ── Support grid (wraps support cards) ── */
.{{ prefix }} .apr__support-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}

/* ── Featured card — horizontal ── */
.{{ prefix }} .apr__card--featured {
  display: grid;
  grid-template-columns: 400px 1fr;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  text-decoration: none;
  box-shadow: 0 2px 8px rgba(44,36,22,0.07);
  transition: transform 0.24s ease, box-shadow 0.24s ease;
  min-height: 260px;
}
.{{ prefix }} .apr__card--featured:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px rgba(44,36,22,0.12);
}

.{{ prefix }} .apr__card--featured .apr__img-wrap {
  position: relative;
  overflow: hidden;
  background: #EDE8DF;
}
.{{ prefix }} .apr__card--featured .apr__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.55s ease;
}
.{{ prefix }} .apr__card--featured:hover .apr__img { transform: scale(1.05); }

.{{ prefix }} .apr__card--featured .apr__img-placeholder {
  width: 100%;
  height: 100%;
  min-height: 260px;
  background: linear-gradient(135deg, #EDE8DF, #DDD5C6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52px;
}

.{{ prefix }} .apr__card--featured .apr__card-body {
  padding: 36px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
}

.{{ prefix }} .apr__card--featured .apr__title {
  font-size: 22px;
}

.{{ prefix }} .apr__card--featured .apr__excerpt {
  font-family: var(--font-body-family);
  font-size: 14px;
  color: rgba(74,63,48,0.65);
  line-height: 1.65;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Support cards — vertical ── */
.{{ prefix }} .apr__card--support {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  text-decoration: none;
  box-shadow: 0 1px 4px rgba(44,36,22,0.06);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.{{ prefix }} .apr__card--support:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(44,36,22,0.10);
}

.{{ prefix }} .apr__card--support .apr__img-wrap {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #EDE8DF;
  position: relative;
  flex-shrink: 0;
}
.{{ prefix }} .apr__card--support .apr__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}
.{{ prefix }} .apr__card--support:hover .apr__img { transform: scale(1.05); }

.{{ prefix }} .apr__card--support .apr__img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #EDE8DF, #DDD5C6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
}

.{{ prefix }} .apr__card--support .apr__card-body {
  padding: 18px 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.{{ prefix }} .apr__card--support .apr__title {
  font-size: 15px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Shared card elements ── */
.{{ prefix }} .apr__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  font-family: var(--font-body-family);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
  background: rgba(200,150,62,0.9);
  color: #fff;
}

.{{ prefix }} .apr__meta {
  display: flex;
  align-items: center;
  gap: 10px;
}

.{{ prefix }} .apr__tag {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #C8963E;
}

.{{ prefix }} .apr__read-time {
  font-family: var(--font-body-family);
  font-size: 11px;
  color: rgba(74,63,48,0.4);
}

.{{ prefix }} .apr__title {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: #2C2416;
  line-height: 1.32;
  margin: 0;
  flex: 1;
}

.{{ prefix }} .apr__read-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #4A7358;
  margin-top: auto;
  transition: gap 0.2s ease;
}
.{{ prefix }} .apr__card--featured:hover .apr__read-link,
.{{ prefix }} .apr__card--support:hover .apr__read-link { gap: 9px; }

/* ── Responsive ── */
@media screen and (max-width: 749px) {
  .{{ prefix }} { padding: 40px 0 52px; }
  .{{ prefix }} .apr__inner { padding: 0 1.5rem; }
  .{{ prefix }} .apr__heading { font-size: 22px; }
  .{{ prefix }} .apr__header { flex-direction: column; align-items: flex-start; gap: 12px; margin-bottom: 28px; }
  .{{ prefix }} .apr__card--featured { grid-template-columns: 1fr; min-height: unset; }
  .{{ prefix }} .apr__card--featured .apr__img-wrap { aspect-ratio: 4 / 3; height: auto; }
  .{{ prefix }} .apr__card--featured .apr__card-body { padding: 20px 20px 24px; gap: 10px; }
  .{{ prefix }} .apr__card--featured .apr__title { font-size: 18px; }
  .{{ prefix }} .apr__card--featured .apr__excerpt { -webkit-line-clamp: 2; }
  .{{ prefix }} .apr__support-grid { grid-template-columns: 1fr; }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .{{ prefix }} .apr__inner { padding: 0 3rem; }
  .{{ prefix }} .apr__card--featured { grid-template-columns: 260px 1fr; }
  .{{ prefix }} .apr__card--featured .apr__card-body { padding: 24px 28px; }
  .{{ prefix }} .apr__support-grid { grid-template-columns: repeat(2, 1fr); }
}
{%- endstyle -%}

<div class="{{ prefix }}">
  <div class="apr__inner">
    <div class="apr__header">
      <div>
        <p class="apr__eyebrow">{{ section.settings.eyebrow | default: 'From Our Kitchen' }}</p>
        <h2 class="apr__heading">{{ section.settings.heading | default: 'Recipes Using This Product' }}</h2>
      </div>
      <a href="{{ blog_obj.url }}" class="apr__all-link">
        All articles
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="apr__layout">
      {{ articles_html }}
    </div>
  </div>
</div>

{%- endif -%}
{%- endif -%}

