            {%- else -%}
              <div class="apr__img-placeholder">🌿</div>
            {%- endif -%}
          </div>
          <div class="apr__card-body">
            <div class="apr__meta">
              {%- if display_tag != blank -%}<span class="apr__tag">{{ display_tag }}</span>{%- endif -%}
              <span class="apr__read-time">{{ read_minutes }} min read</span>
            </div>
            <h3 class="apr__title">{{ a.title | escape }}</h3>
            <span class="apr__read-link">Read <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
