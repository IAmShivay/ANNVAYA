{%- comment -%}
  ANNVAYA — Product Page Recipe Section
  Shows blog articles relevant to the current product.
  Matching logic (in order of priority):
    1. Articles sharing any tag with the product
    2. Fallback: articles tagged 'recipe' or 'recipes'
    3. Last resort: latest articles from the blog
  Layout: horizontal featured card (first) + 4:3 grid cards (rest).
{%- endcomment -%}

{%- liquid
  assign blog_handle        = section.settings.blog | default: 'news'
  assign blog_obj           = blogs[blog_handle]
  assign show_count         = section.settings.articles_to_show | default: 3
  assign prefix             = 'apr-' | append: section.id
  assign product_type_lower = product.type | downcase
-%}

{%- if blog_obj == blank or blog_obj.articles_count == 0 -%}
  {%- comment -%} Nothing to render {%- endcomment -%}
{%- else -%}

{%- comment -%}
  Helper macro: renders one card (featured or support) inside a capture block.
  Variables available via loop: a, hit_count
{%- endcomment -%}

{%- comment -%} ── PASS 1: product-tag matched articles ── {%- endcomment -%}
{%- capture articles_html -%}
  {%- assign hit_count = 0 -%}
  {%- for a in blog_obj.articles -%}
    {%- if hit_count >= show_count -%}{%- break -%}{%- endif -%}
    {%- assign matched = false -%}
    {%- for p_tag in product.tags -%}
      {%- assign pt = p_tag | downcase -%}
      {%- for a_tag in a.tags -%}
        {%- assign a_tag_lower = a_tag | downcase -%}
        {%- if a_tag_lower == pt -%}{%- assign matched = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if matched -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if matched == false and product_type_lower != blank -%}
      {%- assign a_title_lower = a.title | downcase -%}
      {%- if a_title_lower contains product_type_lower -%}{%- assign matched = true -%}{%- endif -%}
    {%- endif -%}
    {%- if matched -%}
      {%- assign word_count = a.content | strip_html | split: ' ' | size -%}
      {%- assign read_minutes = word_count | divided_by: 200 | plus: 1 -%}
      {%- assign display_tag = '' -%}
      {%- for tag in a.tags -%}
        {%- assign tl = tag | downcase -%}
        {%- if tl != 'recipe' and tl != 'recipes' and tl != 'health' and tl != 'wellness' -%}
          {%- assign display_tag = tag -%}{%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if display_tag == blank and a.tags.size > 0 -%}{%- assign display_tag = a.tags.first -%}{%- endif -%}
      {%- if hit_count == 0 -%}
        <a href="{{ a.url }}" class="apr__card apr__card--featured">
          <div class="apr__img-wrap">
            {%- if a.image -%}
              <img src="{{ a.image | image_url: width: 900 }}" srcset="{{ a.image | image_url: width: 600 }} 600w, {{ a.image | image_url: width: 900 }} 900w, {{ a.image | image_url: width: 1200 }} 1200w" sizes="(max-width:749px) 92vw, (max-width:989px) 46vw, 38vw" alt="{{ a.image.alt | escape | default: a.title | escape }}" width="{{ a.image.width }}" height="{{ a.image.height }}" loading="lazy" class="apr__img">
            {%- else -%}
              <div class="apr__img-placeholder">🌿</div>
            {%- endif -%}
            <span class="apr__badge">Recipe</span>
          </div>
          <div class="apr__card-body">
            <div class="apr__meta">
              {%- if display_tag != blank -%}<span class="apr__tag">{{ display_tag }}</span>{%- endif -%}
              <span class="apr__read-time">{{ read_minutes }} min read</span>
            </div>
            <h3 class="apr__title">{{ a.title | escape }}</h3>
            {%- if a.excerpt_or_content != blank -%}<p class="apr__excerpt">{{ a.excerpt_or_content | strip_html | truncatewords: 30 }}</p>{%- endif -%}
            <span class="apr__read-link">Read recipe <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
        {%- if show_count > 1 -%}<div class="apr__support-grid">{%- endif -%}
      {%- else -%}
        <a href="{{ a.url }}" class="apr__card apr__card--support">
          <div class="apr__img-wrap">
            {%- if a.image -%}
              <img src="{{ a.image | image_url: width: 600 }}" srcset="{{ a.image | image_url: width: 400 }} 400w, {{ a.image | image_url: width: 600 }} 600w, {{ a.image | image_url: width: 800 }} 800w" sizes="(max-width:749px) 92vw, (max-width:989px) 46vw, 22vw" alt="{{ a.image.alt | escape | default: a.title | escape }}" width="{{ a.image.width }}" height="{{ a.image.height }}" loading="lazy" class="apr__img">
            {%- else -%}
              <div class="apr__img-placeholder">🌿</div>
            {%- endif -%}
          </div>
          <div class="apr__card-body">
            <div class="apr__meta">
              {%- if display_tag != blank -%}<span class="apr__tag">{{ display_tag }}</span>{%- endif -%}
              <span class="apr__read-time">{{ read_minutes }} min read</span>
            </div>
            <h3 class="apr__title">{{ a.title | escape }}</h3>
            <span class="apr__read-link">Read <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
      {%- endif -%}
      {%- assign hit_count = hit_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if hit_count > 1 -%}</div>{%- endif -%}
{%- endcapture -%}

{%- comment -%} ── PASS 2: recipe-tagged fallback ── {%- endcomment -%}
{%- if articles_html == blank -%}
  {%- capture articles_html -%}
    {%- assign hit_count = 0 -%}
    {%- for a in blog_obj.articles -%}
      {%- if hit_count >= show_count -%}{%- break -%}{%- endif -%}
      {%- assign is_recipe = false -%}
      {%- for tag in a.tags -%}
        {%- assign tl = tag | downcase -%}
        {%- if tl == 'recipe' or tl == 'recipes' -%}{%- assign is_recipe = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if is_recipe -%}
        {%- assign word_count = a.content | strip_html | split: ' ' | size -%}
        {%- assign read_minutes = word_count | divided_by: 200 | plus: 1 -%}
        {%- assign display_tag = '' -%}
        {%- for tag in a.tags -%}
          {%- assign tl = tag | downcase -%}
          {%- if tl != 'recipe' and tl != 'recipes' and tl != 'health' and tl != 'wellness' -%}
            {%- assign display_tag = tag -%}{%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if display_tag == blank and a.tags.size > 0 -%}{%- assign display_tag = a.tags.first -%}{%- endif -%}
        {%- if hit_count == 0 -%}
          <a href="{{ a.url }}" class="apr__card apr__card--featured">
            <div class="apr__img-wrap">
              {%- if a.image -%}
                <img src="{{ a.image | image_url: width: 900 }}" srcset="{{ a.image | image_url: width: 600 }} 600w, {{ a.image | image_url: width: 900 }} 900w, {{ a.image | image_url: width: 1200 }} 1200w" sizes="(max-width:749px) 92vw, (max-width:989px) 46vw, 38vw" alt="{{ a.image.alt | escape | default: a.title | escape }}" width="{{ a.image.width }}" height="{{ a.image.height }}" loading="lazy" class="apr__img">
              {%- else -%}
                <div class="apr__img-placeholder">🌿</div>
              {%- endif -%}
              <span class="apr__badge">Recipe</span>
            </div>
            <div class="apr__card-body">
              <div class="apr__meta">
                {%- if display_tag != blank -%}<span class="apr__tag">{{ display_tag }}</span>{%- endif -%}
                <span class="apr__read-time">{{ read_minutes }} min read</span>
              </div>
              <h3 class="apr__title">{{ a.title | escape }}</h3>
              {%- if a.excerpt_or_content != blank -%}<p class="apr__excerpt">{{ a.excerpt_or_content | strip_html | truncatewords: 30 }}</p>{%- endif -%}
              <span class="apr__read-link">Read recipe <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </div>
          </a>
          {%- if show_count > 1 -%}<div class="apr__support-grid">{%- endif -%}
        {%- else -%}
          <a href="{{ a.url }}" class="apr__card apr__card--support">
            <div class="apr__img-wrap">
              {%- if a.image -%}
                <img src="{{ a.image | image_url: width: 600 }}" srcset="{{ a.image | image_url: width: 400 }} 400w, {{ a.image | image_url: width: 600 }} 600w, {{ a.image | image_url: width: 800 }} 800w" sizes="(max-width:749px) 92vw, (max-width:989px) 46vw, 22vw" alt="{{ a.image.alt | escape | default: a.title | escape }}" width="{{ a.image.width }}" height="{{ a.image.height }}" loading="lazy" class="apr__img">
              {%- else -%}
                <div class="apr__img-placeholder">🌿</div>
              {%- endif -%}
            </div>
            <div class="apr__card-body">
              <div class="apr__meta">
                {%- if display_tag != blank -%}<span class="apr__tag">{{ display_tag }}</span>{%- endif -%}
                <span class="apr__read-time">{{ read_minutes }} min read</span>
              </div>
              <h3 class="apr__title">{{ a.title | escape }}</h3>
              <span class="apr__read-link">Read <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </div>
          </a>
        {%- endif -%}
        {%- assign hit_count = hit_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if hit_count > 1 -%}</div>{%- endif -%}
  {%- endcapture -%}
{%- endif -%}

