{%- comment -%}
  ANNVAYA — Baby Food Editorial Section v2
  Premium emotional storytelling for baby + toddler nutrition.
  Desktop: 45% content / 55% image — organic fades, no card radius.
  Mobile: full-bleed image → warm gradient fade → full content stack.
{%- endcomment -%}

{%- liquid
  assign bf_img = blank
  if section.settings.image != blank
    assign bf_img = section.settings.image | image_url: width: 1400
    assign bf_img_alt = section.settings.image.alt | escape | default: "AnnVaya - Better nutrition for little ones"
  endif
  assign btn_link = section.settings.btn_link | default: '/collections/baby-food'
  assign btn_label = section.settings.btn_label | default: 'Explore Baby Food'
-%}

{%- style -%}
/* ─── ANNVAYA BABY FOOD v2 ──────────────────────────────────────── */
.abf-{{ section.id }} {
  background: #F5F2EB;
  padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px;
  overflow: hidden;
  position: relative;
}

/* Tonal wash behind the photograph column */
.abf-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 56%;
  height: 100%;
  background: #EDE8DF;
  z-index: 0;
  pointer-events: none;
}

/* Decorative ring — editorial texture behind the image area */
.abf-{{ section.id }}::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 12%;
  transform: translateY(-50%);
  width: 480px;
  height: 480px;
  border-radius: 50%;
  border: 1px solid rgba(74, 115, 88, 0.10);
  z-index: 0;
  pointer-events: none;
}

.abf-{{ section.id }} .abf__inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
  display: grid;
  grid-template-columns: 45fr 55fr;
  gap: 0 64px;
  align-items: center;
  min-height: 620px;
}

/* ── CONTENT COLUMN ─────────────────────────────────────────────── */
.abf-{{ section.id }} .abf__content {
  padding: 48px 0;
}

.abf-{{ section.id }} .abf__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.20em;
  text-transform: uppercase;
  color: #C8963E;
  margin-bottom: 26px;
}

.abf-{{ section.id }} .abf__eyebrow::before {
  content: '';
  display: block;
  width: 28px;
  height: 1.5px;
  background: #C8963E;
  flex-shrink: 0;
}

.abf-{{ section.id }} .abf__heading {
  font-family: var(--font-heading-family);
  font-size: 56px;
  font-weight: 700;
  line-height: 1.04;
  color: #2C2416;
  margin: 0 0 6px;
  letter-spacing: -0.03em;
}

.abf-{{ section.id }} .abf__heading-italic {
  display: block;
  font-style: italic;
  color: #4A7358;
  font-size: 54px;
  letter-spacing: -0.025em;
}

.abf-{{ section.id }} .abf__micro-brand {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(74, 63, 48, 0.36);
  margin: 0 0 32px;
}

.abf-{{ section.id }} .abf__body {
  font-family: var(--font-body-family);
  font-size: 17px;
  line-height: 1.76;
  color: #4A3F30;
  max-width: 430px;
  margin-bottom: 38px;
  padding-top: 2px;
  border-top: 2px solid rgba(200, 150, 62, 0.25);
}

/* ── PROMISE GRID (replaces numbered trust list) ─────────────────── */
.abf-{{ section.id }} .abf__promise {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid rgba(74, 63, 48, 0.14);
  margin-bottom: 42px;
}

.abf-{{ section.id }} .abf__promise-item {
  padding: 20px 0;
}

.abf-{{ section.id }} .abf__promise-item + .abf__promise-item {
  border-left: 1px solid rgba(74, 63, 48, 0.10);
  padding-left: 16px;
}

.abf-{{ section.id }} .abf__promise-pip {
  display: block;
  width: 18px;
  height: 2px;
  background: #C8963E;
  border-radius: 1px;
  margin-bottom: 10px;
}

.abf-{{ section.id }} .abf__promise-label {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2C2416;
  display: block;
  margin-bottom: 4px;
  line-height: 1.4;
}

.abf-{{ section.id }} .abf__promise-desc {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: rgba(74, 63, 48, 0.58);
  line-height: 1.45;
  font-style: italic;
  display: block;
}

/* ── CTA ────────────────────────────────────────────────────────── */
.abf-{{ section.id }} .abf__cta {
  display: flex;
  align-items: center;
  gap: 28px;
}

.abf-{{ section.id }} .abf__btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #F5F2EB;
  background: #4A7358;
  border: none;
  padding: 0 36px;
  height: 54px;
  border-radius: 4px;
  text-decoration: none;
  transition: background 0.25s ease, gap 0.25s ease;
  cursor: pointer;
  flex-shrink: 0;
}

.abf-{{ section.id }} .abf__btn:hover {
  background: #3B5C46;
  gap: 20px;
}

.abf-{{ section.id }} .abf__btn-arrow {
  font-size: 16px;
  line-height: 1;
  transition: transform 0.25s ease;
}

.abf-{{ section.id }} .abf__btn:hover .abf__btn-arrow {
  transform: translateX(4px);
}

.abf-{{ section.id }} .abf__assurance {
  font-family: var(--font-body-family);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(74, 63, 48, 0.35);
  line-height: 1.6;
}

/* ── IMAGE COLUMN ───────────────────────────────────────────────── */
.abf-{{ section.id }} .abf__media {
  position: relative;
  align-self: stretch;
  display: flex;
  align-items: center;
}

.abf-{{ section.id }} .abf__img-wrap {
  position: relative;
  width: 100%;
  margin-top: -{{ section.settings.padding_top | default: 80 }}px;
  margin-bottom: -{{ section.settings.padding_bottom | default: 80 }}px;
  min-height: 680px;
  overflow: hidden;
  /* No border-radius — organic integration via multi-side fades */
}

.abf-{{ section.id }} .abf__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  display: block;
  transition: transform 1.1s ease;
  position: absolute;
  inset: 0;
}

.abf-{{ section.id }} .abf__img-wrap:hover .abf__img {
  transform: scale(1.04);
}

/* Wide organic left fade — connects image to cream content area naturally */
.abf-{{ section.id }} .abf__fade-left {
  position: absolute;
  top: 0;
  left: 0;
  width: 160px;
  height: 100%;
  background: linear-gradient(
    to right,
    #EDE8DF 0%,
    rgba(237, 232, 223, 0.80) 18%,
    rgba(237, 232, 223, 0.35) 52%,
    transparent 100%
  );
  z-index: 2;
  pointer-events: none;
}

/* Top edge softener */
.abf-{{ section.id }} .abf__fade-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 72px;
  background: linear-gradient(to bottom, #EDE8DF 0%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

/* Bottom edge softener */
.abf-{{ section.id }} .abf__fade-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 72px;
  background: linear-gradient(to top, #EDE8DF 0%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

/* Warm cinematic overlay on photo */
.abf-{{ section.id }} .abf__img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    155deg,
    rgba(200, 150, 62, 0.04) 0%,
    rgba(44, 36, 22, 0.10) 100%
  );
  z-index: 1;
  pointer-events: none;
}

/* Botanical leaf — top right, very subtle */
.abf-{{ section.id }} .abf__botanical {
  position: absolute;
  top: 36px;
  right: 32px;
  z-index: 3;
  opacity: 0.08;
  pointer-events: none;
  mix-blend-mode: multiply;
}

/* ── TABLET ─────────────────────────────────────────────────────── */
@media screen and (min-width: 750px) and (max-width: 989px) {
  .abf-{{ section.id }} .abf__inner {
    gap: 0 36px;
    padding: 0 3rem;
    grid-template-columns: 48fr 52fr;
  }

  .abf-{{ section.id }} .abf__heading {
    font-size: 42px;
  }

  .abf-{{ section.id }} .abf__heading-italic {
    font-size: 40px;
  }

  .abf-{{ section.id }} .abf__img-wrap {
    min-height: 520px;
  }
}

/* ── MOBILE ─────────────────────────────────────────────────────── */
@media screen and (max-width: 749px) {
  .abf-{{ section.id }} {
    padding: 0 0 56px;
    overflow: hidden;
  }

  .abf-{{ section.id }}::before,
  .abf-{{ section.id }}::after {
    display: none;
  }

  .abf-{{ section.id }} .abf__inner {
    grid-template-columns: 1fr;
    gap: 0;
    padding: 0;
    min-height: 0;
  }

  /* Image on top */
  .abf-{{ section.id }} .abf__media {
    order: 1;
    align-self: auto;
  }

  .abf-{{ section.id }} .abf__img-wrap {
    margin: 0;
    min-height: clamp(300px, 85vw, 420px);
    overflow: hidden;
    position: relative;
  }

  .abf-{{ section.id }} .abf__img {
    position: absolute;
    inset: 0;
    object-position: center 15%;
  }

  /* Soft warm fade at bottom — image dissolves into cream content */
  .abf-{{ section.id }} .abf__img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 62%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(245, 242, 235, 0.18) 32%,
      rgba(245, 242, 235, 0.62) 58%,
      rgba(245, 242, 235, 0.92) 80%,
      #F5F2EB 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Hide desktop-only decorative edges */
  .abf-{{ section.id }} .abf__fade-left,
  .abf-{{ section.id }} .abf__fade-top,
  .abf-{{ section.id }} .abf__fade-bottom,
  .abf-{{ section.id }} .abf__botanical {
    display: none;
  }

  /* Content below */
  .abf-{{ section.id }} .abf__content {
    order: 2;
    padding: 8px 22px 0;
  }

  .abf-{{ section.id }} .abf__heading {
    font-size: 34px;
    margin-bottom: 4px;
  }

  .abf-{{ section.id }} .abf__heading-italic {
    font-size: 32px;
  }

  .abf-{{ section.id }} .abf__body {
    font-size: 15px;
    max-width: 100%;
    margin-bottom: 30px;
  }

  /* Stack promise items vertically on mobile */
  .abf-{{ section.id }} .abf__promise {
    grid-template-columns: 1fr;
    margin-bottom: 34px;
  }

  .abf-{{ section.id }} .abf__promise-item + .abf__promise-item {
    border-left: none;
    border-top: 1px solid rgba(74, 63, 48, 0.10);
    padding-left: 0;
  }

  .abf-{{ section.id }} .abf__cta {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .abf-{{ section.id }} .abf__btn {
    width: 100%;
    justify-content: center;
    height: 52px;
  }
}
{%- endstyle -%}

<div class="abf-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="abf__inner">

    {%- comment -%} CONTENT LEFT {%- endcomment -%}
    <div class="abf__content">

      <p class="abf__eyebrow">{{ section.settings.eyebrow | default: 'For Little Beginnings' }}</p>

      <h2 class="abf__heading">
        {{ section.settings.heading_line1 | default: 'Better Than Cereal.' }}
        <em class="abf__heading-italic">{{ section.settings.heading_line2 | default: 'Made by Nature.' }}</em>
      </h2>

      <p class="abf__micro-brand">{{ section.settings.micro_text | default: 'Real food · Simple ingredients · No shortcuts' }}</p>

      <p class="abf__body">{{ section.settings.body_text | default: 'Simple, wholesome nutrition made from ingredients you can recognise. Thoughtfully prepared for little appetites, growing bodies and everyday family moments.' }}</p>

      {%- comment -%} 3-column promise grid {%- endcomment -%}
      <div class="abf__promise">
        {%- if section.settings.trust_1_label != blank -%}
          <div class="abf__promise-item">
            <span class="abf__promise-pip"></span>
            <span class="abf__promise-label">{{ section.settings.trust_1_label }}</span>
            {%- if section.settings.trust_1_desc != blank -%}
              <span class="abf__promise-desc">{{ section.settings.trust_1_desc }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.trust_2_label != blank -%}
          <div class="abf__promise-item">
            <span class="abf__promise-pip"></span>
            <span class="abf__promise-label">{{ section.settings.trust_2_label }}</span>
            {%- if section.settings.trust_2_desc != blank -%}
              <span class="abf__promise-desc">{{ section.settings.trust_2_desc }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.trust_3_label != blank -%}
          <div class="abf__promise-item">
            <span class="abf__promise-pip"></span>
            <span class="abf__promise-label">{{ section.settings.trust_3_label }}</span>
            {%- if section.settings.trust_3_desc != blank -%}
              <span class="abf__promise-desc">{{ section.settings.trust_3_desc }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="abf__cta">
        <a href="{{ btn_link }}" class="abf__btn">
          {{ btn_label }}
          <span class="abf__btn-arrow" aria-hidden="true">→</span>
        </a>
        {%- if section.settings.assurance_text != blank -%}
          <span class="abf__assurance">{{ section.settings.assurance_text }}</span>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} IMAGE RIGHT {%- endcomment -%}
    <div class="abf__media">
      <div class="abf__img-wrap">
        {%- if bf_img != blank -%}
          <img
            src="{{ bf_img }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1400 }} 1400w
            "
            sizes="(max-width: 749px) 100vw, 55vw"
            alt="{{ bf_img_alt }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="abf__img"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'abf__img placeholder-svg' }}
        {%- endif -%}

        <div class="abf__fade-left"></div>
        <div class="abf__fade-top"></div>
        <div class="abf__fade-bottom"></div>
        <div class="abf__img-overlay"></div>
      </div>

      {%- comment -%} Botanical SVG — editorial texture {%- endcomment -%}
      <svg class="abf__botanical" width="80" height="96" viewBox="0 0 80 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M40 92 C40 92 6 70 6 38 C6 18 20 4 40 4 C60 4 74 18 74 38 C74 70 40 92 40 92Z" fill="#4A7358"/>
        <path d="M40 4 L40 92" stroke="#F5F2EB" stroke-width="1.2" opacity="0.6"/>
        <path d="M22 32 C22 32 40 42 58 32" stroke="#F5F2EB" stroke-width="1" opacity="0.4" fill="none"/>
        <path d="M16 50 C16 50 40 62 64 50" stroke="#F5F2EB" stroke-width="1" opacity="0.3" fill="none"/>
        <path d="M20 68 C20 68 40 76 60 68" stroke="#F5F2EB" stroke-width="0.8" opacity="0.2" fill="none"/>
      </svg>
    </div>

  </div>
</div>

