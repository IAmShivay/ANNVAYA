      "type": "textarea",
      "id": "body_text",
      "label": "Body copy",
      "default": "Simple, wholesome nutrition made from ingredients you can recognise. Thoughtfully prepared for little appetites, growing bodies and everyday family moments."
    },
    {
      "type": "header",
      "content": "Promise Points"
    },
    {
      "type": "text",
      "id": "trust_1_label",
      "label": "Promise 1 label",
      "default": "Real Ingredients"
    },
    {
      "type": "text",
      "id": "trust_1_desc",
      "label": "Promise 1 description",
      "default": "Nothing unnecessary."
    },
    {
      "type": "text",
      "id": "trust_2_label",
      "label": "Promise 2 label",
      "default": "No Added Sugar"
    },
    {
      "type": "text",
      "id": "trust_2_desc",
      "label": "Promise 2 description",
      "default": "Simple food, naturally."
    },
    {
      "type": "text",
      "id": "trust_3_label",
      "label": "Promise 3 label",
      "default": "Made for Little Ones"
    },
    {
      "type": "text",
      "id": "trust_3_desc",
      "label": "Promise 3 description",
      "default": "Gentle everyday nutrition."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "btn_label",
