{%- comment -%}
  ANNVAYA — Blog Listing Page
  Full vertical layout:
    - Dark header + filter tabs
    - Featured hero card (full-width image with gradient overlay text)
    - 3-column vertical card grid
    - Pagination
{%- endcomment -%}

{%- assign current_tag = current_tags.first | downcase -%}

{%- style -%}
.av-blog { background: #F5F2EB; min-height: 60vh; }

/* ── Header ── */
.av-blog__header {
  background: #2C2416;
  padding: 64px 0 0;
}
.av-blog__header-inner {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
}
.av-blog__eyebrow {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #C8963E;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
.av-blog__eyebrow::before {
  content: '';
  width: 28px;
  height: 1.5px;
  background: #C8963E;
  display: block;
}
.av-blog__title {
  font-family: var(--font-heading-family);
  font-size: 48px;
  font-weight: 700;
  color: #F5F2EB;
  margin: 0 0 10px;
  letter-spacing: -0.02em;
  line-height: 1.05;
}
.av-blog__desc {
  font-family: var(--font-body-family);
  font-size: 15px;
  color: rgba(245,242,235,0.55);
  margin: 0 0 36px;
  max-width: 440px;
  line-height: 1.65;
}

/* ── Filter tabs ── */
.av-blog__tabs {
  display: flex;
  gap: 0;
  border-top: 1px solid rgba(245,242,235,0.08);
  margin-top: 4px;
}
.av-blog__tab {
  font-family: var(--font-body-family);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(245,242,235,0.45);
  text-decoration: none;
  padding: 16px 22px 14px;
  border-bottom: 2px solid transparent;
  transition: color 0.2s, border-color 0.2s;
  white-space: nowrap;
}
.av-blog__tab:hover { color: rgba(245,242,235,0.85); }
.av-blog__tab--active { color: #C8963E; border-bottom-color: #C8963E; }

/* ── Body ── */
.av-blog__body {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 48px 5rem 80px;
}

/* ─────────────────────────────────────────
   FEATURED HERO CARD (full-width vertical)
   ───────────────────────────────────────── */
.av-blog__hero {
  display: block;
  text-decoration: none;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
  aspect-ratio: 21 / 9;
  background: #2C2416;
  margin-bottom: 52px;
  transition: box-shadow 0.3s ease;
}
.av-blog__hero:hover {
  box-shadow: 0 20px 56px rgba(44,36,22,0.22);
}

.av-blog__hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.7s ease;
}
.av-blog__hero:hover .av-blog__hero-img { transform: scale(1.03); }

.av-blog__hero-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #3A2E1C, #4A3B2A);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80px;
}

/* Gradient overlay — bottom */
.av-blog__hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(20,14,6,0.88) 0%,
    rgba(20,14,6,0.55) 35%,
    rgba(20,14,6,0.10) 65%,
    transparent 100%
  );
  pointer-events: none;
}

.av-blog__hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 44px 52px;
  z-index: 1;
}
.av-blog__hero-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
}
.av-blog__hero-badge {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 20px;
}
.av-blog__hero-badge--recipe { background: rgba(200,150,62,0.9); color: #fff; }
.av-blog__hero-badge--health  { background: rgba(74,115,88,0.9); color: #fff; }
.av-blog__hero-badge--default { background: rgba(245,242,235,0.15); color: rgba(245,242,235,0.85); }

.av-blog__hero-date {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: rgba(245,242,235,0.55);
}
.av-blog__hero-read-time {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: rgba(245,242,235,0.45);
}

.av-blog__hero-title {
  font-family: var(--font-heading-family);
  font-size: 34px;
  font-weight: 700;
  color: #F5F2EB;
  line-height: 1.2;
  letter-spacing: -0.015em;
  margin: 0 0 16px;
  max-width: 680px;
}
.av-blog__hero-excerpt {
  font-family: var(--font-body-family);
  font-size: 15px;
  color: rgba(245,242,235,0.65);
  line-height: 1.65;
  margin: 0 0 22px;
  max-width: 560px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.av-blog__hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body-family);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: #C8963E;
  transition: gap 0.2s ease;
}
.av-blog__hero:hover .av-blog__hero-cta { gap: 13px; }

/* ─────────────────────────────────────────
   GRID
   ───────────────────────────────────────── */
.av-blog__section-label {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(74,63,48,0.4);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.av-blog__section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(74,63,48,0.12);
}

.av-blog__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

/* ── Card ── */
.av-blog__card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  box-shadow: 0 1px 4px rgba(44,36,22,0.06), 0 0 0 1px rgba(44,36,22,0.04);
  transition: transform 0.24s ease, box-shadow 0.24s ease;
}
.av-blog__card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(44,36,22,0.12), 0 0 0 1px rgba(44,36,22,0.06);
}

/* Image */
.av-blog__card-img-wrap {
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #EDE8DF;
  position: relative;
  flex-shrink: 0;
}
.av-blog__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.55s ease;
}
.av-blog__card:hover .av-blog__card-img { transform: scale(1.06); }
.av-blog__card-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #EDE8DF, #DDD5C6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
}

.av-blog__card-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  font-family: var(--font-body-family);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
}
.av-blog__card-badge--recipe { background: rgba(200,150,62,0.9); color: #fff; }
.av-blog__card-badge--health  { background: rgba(74,115,88,0.9); color: #fff; }

/* Body */
.av-blog__card-body {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 10px;
}
.av-blog__card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.av-blog__card-tag {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #C8963E;
}
.av-blog__card-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(74,63,48,0.25);
  flex-shrink: 0;
}
.av-blog__card-date {
  font-family: var(--font-body-family);
  font-size: 11px;
  color: rgba(74,63,48,0.4);
}
.av-blog__card-title {
  font-family: var(--font-heading-family);
  font-size: 18px;
  font-weight: 700;
  color: #2C2416;
  line-height: 1.3;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.av-blog__card-excerpt {
  font-family: var(--font-body-family);
  font-size: 13px;
  color: rgba(74,63,48,0.58);
  line-height: 1.65;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.av-blog__card-read {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #4A7358;
  margin-top: auto;
  padding-top: 4px;
  border-top: 1px solid rgba(74,63,48,0.08);
  transition: gap 0.2s ease;
}
.av-blog__card:hover .av-blog__card-read { gap: 10px; }

/* ── Pagination ── */
.av-blog__pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid rgba(74,63,48,0.1);
}
.av-blog__pagination a,
.av-blog__pagination span {
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 600;
  color: #4A3B2A;
  text-decoration: none;
  min-width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  border-radius: 6px;
  border: 1px solid rgba(74,63,48,0.14);
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.av-blog__pagination a:hover { background: #2C2416; color: #F5F2EB; border-color: #2C2416; }
.av-blog__pg--active { background: #4A7358 !important; color: #fff !important; border-color: #4A7358 !important; }

/* ── Responsive ── */
@media screen and (max-width: 749px) {
  .av-blog__header { padding: 44px 0 0; }
  .av-blog__header-inner, .av-blog__body { padding-left: 1.5rem; padding-right: 1.5rem; }
  .av-blog__title { font-size: 30px; }
  .av-blog__hero { aspect-ratio: 4 / 3; }
  .av-blog__hero-content { padding: 24px 20px; }
  .av-blog__hero-title { font-size: 22px; }
  .av-blog__hero-excerpt { display: none; }
  .av-blog__grid { grid-template-columns: 1fr; gap: 16px; }
  .av-blog__body { padding-top: 32px; padding-bottom: 52px; }
}
@media screen and (min-width: 750px) and (max-width: 989px) {
  .av-blog__header-inner, .av-blog__body { padding-left: 3rem; padding-right: 3rem; }
  .av-blog__hero { aspect-ratio: 16 / 7; }
  .av-blog__hero-title { font-size: 26px; }
  .av-blog__grid { grid-template-columns: repeat(2, 1fr); }
  .av-blog__title { font-size: 36px; }
}
{%- endstyle -%}

<div class="av-blog">

  <!-- Header + tabs -->
  <div class="av-blog__header">
    <div class="av-blog__header-inner">
      <p class="av-blog__eyebrow">AnnVaya Journal</p>
      <h1 class="av-blog__title">{{ blog.title | escape }}</h1>
      <p class="av-blog__desc">Recipes, health reads, and everyday kitchen wisdom — powered by real ingredients.</p>
    </div>
    <div class="av-blog__header-inner" style="padding-top:0;">
      <div class="av-blog__tabs">
        <a href="{{ blog.url }}" class="av-blog__tab{% unless current_tags %} av-blog__tab--active{% endunless %}">All</a>
        <a href="{{ blog.url }}/tagged/recipe" class="av-blog__tab{% if current_tag == 'recipe' or current_tag == 'recipes' %} av-blog__tab--active{% endif %}">Recipes</a>
        <a href="{{ blog.url }}/tagged/health" class="av-blog__tab{% if current_tag == 'health' or current_tag == 'wellness' %} av-blog__tab--active{% endif %}">Health & Wellness</a>
      </div>
    </div>
  </div>

  <div class="av-blog__body">
    {%- paginate blog.articles by 10 -%}

    {%- comment -%} ── Hero featured card ── {%- endcomment -%}
    {%- assign hero = blog.articles.first -%}
    {%- if hero -%}
      {%- assign h_badge_class = 'default' -%}
      {%- assign h_badge_label = '' -%}
      {%- for tag in hero.tags -%}
        {%- assign tl = tag | downcase -%}
        {%- if tl == 'recipe' or tl == 'recipes' -%}
          {%- assign h_badge_class = 'recipe' -%}
          {%- assign h_badge_label = 'Recipe' -%}
          {%- break -%}
        {%- elsif tl == 'health' or tl == 'wellness' or tl == 'nutrition' -%}
          {%- assign h_badge_class = 'health' -%}
          {%- assign h_badge_label = 'Health' -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign h_tag = '' -%}
      {%- for tag in hero.tags -%}
        {%- assign tl = tag | downcase -%}
        {%- if tl != 'recipe' and tl != 'recipes' and tl != 'health' and tl != 'wellness' and tl != 'nutrition' -%}
          {%- assign h_tag = tag -%}{%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign h_words = hero.content | strip_html | split: ' ' | size -%}
      {%- assign h_read = h_words | divided_by: 200 | plus: 1 -%}

      <a href="{{ hero.url }}" class="av-blog__hero">
        {%- if hero.image -%}
          <img
            src="{{ hero.image | image_url: width: 1600 }}"
            srcset="{{ hero.image | image_url: width: 800 }} 800w, {{ hero.image | image_url: width: 1200 }} 1200w, {{ hero.image | image_url: width: 1600 }} 1600w"
            sizes="(max-width:749px) 92vw, (max-width:989px) 88vw, 100vw"
            alt="{{ hero.image.alt | escape | default: hero.title | escape }}"
            width="{{ hero.image.width }}"
            height="{{ hero.image.height }}"
            loading="eager"
            fetchpriority="high"
            class="av-blog__hero-img">
        {%- else -%}
          <div class="av-blog__hero-placeholder">🌿</div>
        {%- endif -%}
        <div class="av-blog__hero-content">
          <div class="av-blog__hero-meta">
            {%- if h_badge_label != blank -%}
              <span class="av-blog__hero-badge av-blog__hero-badge--{{ h_badge_class }}">{{ h_badge_label }}</span>
            {%- endif -%}
            {%- if h_tag != blank -%}<span class="av-blog__hero-date">{{ h_tag }}</span>{%- endif -%}
            <span class="av-blog__hero-date">{{ hero.published_at | date: '%b %d, %Y' }}</span>
            <span class="av-blog__hero-read-time">· {{ h_read }} min read</span>
          </div>
          <h2 class="av-blog__hero-title">{{ hero.title | escape }}</h2>
          {%- if hero.excerpt_or_content != blank -%}
            <p class="av-blog__hero-excerpt">{{ hero.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
          {%- endif -%}
          <span class="av-blog__hero-cta">
            Read article
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    {%- endif -%}

    {%- comment -%} ── Grid cards ── {%- endcomment -%}
    {%- assign remaining = blog.articles | slice: 1, 50 -%}
    {%- if remaining.size > 0 -%}
      <p class="av-blog__section-label">More Articles</p>
      <div class="av-blog__grid">
        {%- for article in remaining -%}
          {%- assign badge_class = '' -%}
          {%- assign badge_label = '' -%}
          {%- for tag in article.tags -%}
            {%- assign tl = tag | downcase -%}
            {%- if tl == 'recipe' or tl == 'recipes' -%}
              {%- assign badge_class = 'recipe' -%}
              {%- assign badge_label = 'Recipe' -%}
              {%- break -%}
            {%- elsif tl == 'health' or tl == 'wellness' or tl == 'nutrition' -%}
              {%- assign badge_class = 'health' -%}
              {%- assign badge_label = 'Health' -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign disp_tag = '' -%}
          {%- for tag in article.tags -%}
            {%- assign tl = tag | downcase -%}
            {%- if tl != 'recipe' and tl != 'recipes' and tl != 'health' and tl != 'wellness' and tl != 'nutrition' -%}
              {%- assign disp_tag = tag -%}{%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if disp_tag == blank and article.tags.size > 0 -%}{%- assign disp_tag = article.tags.first -%}{%- endif -%}
          {%- assign words = article.content | strip_html | split: ' ' | size -%}
          {%- assign read_min = words | divided_by: 200 | plus: 1 -%}

          <a href="{{ article.url }}" class="av-blog__card">
            <div class="av-blog__card-img-wrap">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 700 }}"
                  srcset="{{ article.image | image_url: width: 450 }} 450w, {{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 900 }} 900w"
                  sizes="(max-width:749px) 90vw, (max-width:989px) 44vw, 30vw"
                  alt="{{ article.image.alt | escape | default: article.title | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                  class="av-blog__card-img">
              {%- else -%}
                <div class="av-blog__card-img-placeholder">🌿</div>
              {%- endif -%}
              {%- if badge_label != blank -%}
                <span class="av-blog__card-badge av-blog__card-badge--{{ badge_class }}">{{ badge_label }}</span>
              {%- endif -%}
            </div>
            <div class="av-blog__card-body">
              <div class="av-blog__card-meta">
                {%- if disp_tag != blank -%}<span class="av-blog__card-tag">{{ disp_tag }}</span><span class="av-blog__card-dot"></span>{%- endif -%}
                <span class="av-blog__card-date">{{ article.published_at | date: '%b %d' }}</span>
                <span class="av-blog__card-dot"></span>
                <span class="av-blog__card-date">{{ read_min }} min</span>
              </div>
              <h3 class="av-blog__card-title">{{ article.title | escape }}</h3>
              {%- if article.excerpt_or_content != blank -%}
                <p class="av-blog__card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
              {%- endif -%}
              <span class="av-blog__card-read">
                Read article
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Pagination ── {%- endcomment -%}
    {%- if paginate.pages > 1 -%}
      <nav class="av-blog__pagination" aria-label="Blog pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" aria-label="Previous page">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="av-blog__pg--active" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" aria-label="Next page">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog Listing",
  "tag": "section",
  "class": "annvaya-blog"
}
{% endschema %}
