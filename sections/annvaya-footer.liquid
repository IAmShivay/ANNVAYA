{%- comment -%}
  ANNVAYA — Custom Footer
  5-column layout: Brand | Shop | Company | Legal | Contact
  All columns in one row on desktop. 2-col on tablet. 1-col on mobile.
{%- endcomment -%}

{%- style -%}
.avf {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px 0 0;
}

/* ── NEWSLETTER BAR ─────────────────────────────────────────────── */
.avf__newsletter {
  border-bottom: 1px solid rgba(255,255,255,0.10);
  padding-bottom: 32px;
  margin-bottom: 48px;
}

.avf__newsletter-inner {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.avf__newsletter-heading {
  font-family: var(--font-heading-family);
  font-size: 22px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  margin: 0;
  flex-shrink: 0;
}

.avf__newsletter-form {
  display: flex;
  gap: 0;
  max-width: 420px;
  width: 100%;
}

.avf__newsletter-input {
  flex: 1;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  border-right: none;
  color: {{ section.settings.text_color }};
  font-family: var(--font-body-family);
  font-size: 14px;
  padding: 0 16px;
  height: 46px;
  outline: none;
  border-radius: 4px 0 0 4px;
}

.avf__newsletter-input::placeholder {
  color: rgba(255,255,255,0.40);
}

.avf__newsletter-btn {
  background: #C8963E;
  border: none;
  color: #fff;
  font-family: var(--font-body-family);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0 22px;
  height: 46px;
  cursor: pointer;
  border-radius: 0 4px 4px 0;
  transition: background 0.2s;
  flex-shrink: 0;
}

.avf__newsletter-btn:hover {
  background: #b07d2f;
}

/* ── MAIN GRID ──────────────────────────────────────────────────── */
.avf__main {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1.6fr;
  gap: 0 48px;
}

/* ── BRAND COLUMN ───────────────────────────────────────────────── */
.avf__brand-name {
  font-family: var(--font-heading-family);
  font-size: 20px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  margin: 0 0 10px;
}

.avf__brand-tagline {
  font-family: var(--font-body-family);
  font-size: 13px;
  line-height: 1.65;
  color: rgba(255,255,255,0.58);
  margin: 0 0 24px;
  max-width: 240px;
}

.avf__social {
  display: flex;
  gap: 14px;
  margin-bottom: 0;
  flex-wrap: wrap;
}

.avf__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.70);
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
  font-size: 14px;
}

.avf__social-link:hover {
  background: #C8963E;
  color: #fff;
}

.avf__social-link svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

/* ── NAV COLUMNS (Shop / Company / Legal) ───────────────────────── */
.avf__col-heading {
  font-family: var(--font-body-family);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #C8963E;
  margin: 0 0 16px;
}

.avf__nav {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.avf__nav-link {
  font-family: var(--font-body-family);
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: color 0.2s;
  line-height: 1.4;
}

.avf__nav-link:hover {
  color: {{ section.settings.text_color }};
}

/* ── CONTACT COLUMN ─────────────────────────────────────────────── */
.avf__contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 14px;
}

.avf__contact-item:last-child {
  margin-bottom: 0;
}

.avf__contact-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  margin-top: 2px;
  color: #C8963E;
  fill: #C8963E;
}

.avf__contact-text {
  font-family: var(--font-body-family);
  font-size: 13px;
  line-height: 1.55;
  color: rgba(255,255,255,0.65);
}

.avf__contact-text a {
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: color 0.2s;
}

.avf__contact-text a:hover {
  color: {{ section.settings.text_color }};
}

/* ── BOTTOM BAR ─────────────────────────────────────────────────── */
.avf__bottom {
  margin-top: 48px;
  border-top: 1px solid rgba(255,255,255,0.10);
  padding: 20px 0;
}

.avf__bottom-inner {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.avf__copyright {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: rgba(255,255,255,0.38);
  margin: 0;
}

.avf__bottom-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.avf__bottom-link {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: rgba(255,255,255,0.38);
  text-decoration: none;
  transition: color 0.2s;
}

.avf__bottom-link:hover {
  color: rgba(255,255,255,0.70);
}

/* ── TABLET ─────────────────────────────────────────────────────── */
@media screen and (min-width: 750px) and (max-width: 989px) {
  .avf__main {
    grid-template-columns: 1fr 1fr;
    gap: 36px 40px;
    padding: 0 3rem;
  }

  .avf__newsletter-inner {
    flex-direction: column;
    align-items: flex-start;
    padding: 0 3rem;
  }

  .avf__newsletter-form {
    max-width: 100%;
    width: 100%;
  }

  .avf__bottom-inner {
    padding: 0 3rem;
  }
}

/* ── MOBILE ─────────────────────────────────────────────────────── */
@media screen and (max-width: 749px) {
  .avf__newsletter-inner {
    flex-direction: column;
    align-items: flex-start;
    padding: 0 22px;
  }

  .avf__newsletter-heading {
    font-size: 18px;
  }

  .avf__newsletter-form {
    max-width: 100%;
    width: 100%;
  }

  .avf__main {
    grid-template-columns: 1fr 1fr;
    gap: 32px 24px;
    padding: 0 22px;
  }

  .avf__brand-col {
    grid-column: 1 / -1;
  }

  .avf__contact-col {
    grid-column: 1 / -1;
  }

  .avf__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
    padding: 0 22px;
    gap: 12px;
  }
}
{%- endstyle -%}

<footer class="avf">

  {%- comment -%} Newsletter {%- endcomment -%}
  {%- if section.settings.newsletter_enable -%}
  <div class="avf__newsletter">
    <div class="avf__newsletter-inner">
      <h2 class="avf__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
      {% form 'customer', class: 'avf__newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="avf__newsletter-input"
          placeholder="Your email address"
          autocomplete="email"
          required
        >
        <button type="submit" class="avf__newsletter-btn">Subscribe</button>
      {% endform %}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} Main 5-column grid {%- endcomment -%}
  <div class="avf__main">

    {%- comment -%} Brand column {%- endcomment -%}
    <div class="avf__brand-col">
      {%- if settings.brand_image -%}
        <img
          src="{{ settings.brand_image | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="120"
          height="auto"
          style="max-width:120px;height:auto;margin-bottom:12px;display:block;"
          loading="lazy"
        >
      {%- else -%}
        <p class="avf__brand-name">{{ shop.name }}</p>
      {%- endif -%}
      <p class="avf__brand-tagline">{{ section.settings.brand_tagline | default: "100% natural dehydrated food powders made in small batches. From farm to your kitchen, nothing added." }}</p>

      <div class="avf__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="avf__social-link" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="avf__social-link" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" class="avf__social-link" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <a href="{{ settings.social_pinterest_link }}" class="avf__social-link" target="_blank" rel="noopener" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Shop column {%- endcomment -%}
    <div>
      <h3 class="avf__col-heading">Shop</h3>
      <ul class="avf__nav">
        {%- for link in section.settings.shop_menu.links -%}
          <li><a href="{{ link.url }}" class="avf__nav-link">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Company column {%- endcomment -%}
    <div>
      <h3 class="avf__col-heading">Company</h3>
      <ul class="avf__nav">
        {%- for link in section.settings.company_menu.links -%}
          <li><a href="{{ link.url }}" class="avf__nav-link">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Legal column {%- endcomment -%}
    <div>
      <h3 class="avf__col-heading">Legal</h3>
      <ul class="avf__nav">
        {%- for link in section.settings.legal_menu.links -%}
          <li><a href="{{ link.url }}" class="avf__nav-link">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Contact column {%- endcomment -%}
    <div class="avf__contact-col">
      <h3 class="avf__col-heading">Contact & Support</h3>

      {%- if section.settings.contact_email != blank -%}
        <div class="avf__contact-item">
          <svg class="avf__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span class="avf__contact-text"><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></span>
        </div>
      {%- endif -%}

      {%- if section.settings.contact_phone != blank -%}
        <div class="avf__contact-item">
          <svg class="avf__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <span class="avf__contact-text"><a href="tel:{{ section.settings.contact_phone }}">{{ section.settings.contact_phone }}</a></span>
        </div>
      {%- endif -%}

      {%- if section.settings.business_hours != blank -%}
        <div class="avf__contact-item">
          <svg class="avf__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
          <span class="avf__contact-text">{{ section.settings.business_hours }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.office_address != blank -%}
        <div class="avf__contact-item">
          <svg class="avf__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span class="avf__contact-text">{{ section.settings.office_address }}</span>
        </div>
      {%- endif -%}
    </div>

  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="avf__bottom">
    <div class="avf__bottom-inner">
      <p class="avf__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="avf__bottom-links">
        <a href="/pages/privacy-policy" class="avf__bottom-link">Privacy</a>
        <a href="/pages/terms-of-service" class="avf__bottom-link">Terms</a>
        <a href="/pages/shipping-policy" class="avf__bottom-link">Shipping</a>
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "AnnVaya Footer",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#2C2416"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#F5F2EB"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand tagline / description",
      "default": "100% natural dehydrated food powders made in small batches. From farm to your kitchen, nothing added."
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "header",
      "content": "Contact Details"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "hello@annvaya.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone / WhatsApp",
      "placeholder": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "business_hours",
      "label": "Business hours",
      "default": "Mon – Sat, 10 AM – 6 PM IST"
    },
    {
      "type": "textarea",
      "id": "office_address",
      "label": "Office address",
      "placeholder": "123 Street, City, State – 400001"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "AnnVaya Footer"
    }
  ]
}
{% endschema %}
