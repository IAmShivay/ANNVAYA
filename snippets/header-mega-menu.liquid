{% comment %}
  ANNVAYA — Premium Mega Menu (v4)
  Layout  : Left panel (~76%) category navigation + Right panel (~24%) brand story
  Design  : Warm cream base, Cormorant headings, botanical SVG accents,
            refined navigation feel — not a card grid.
{% endcomment %}

<style>
  /*
    NOTE: Dawn sets html { font-size: calc(var(--font-body-scale) * 62.5%) }
    At body_scale:100 → html font-size = 62.5% of 16px = 10px → 1rem = 10px.
    All sizes below use px to be immune to this scaling.
  */

  /* ══ Entrance animation ══════════════════════════════════════════════ */
  @keyframes ann-menu-in {
    from { opacity: 0; transform: translateX(-50%) translateY(-6px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0);    }
  }

  /* ══ Panel base ══════════════════════════════════════════════════════ */
  .mega-menu__content.annvaya-mega-panel {
    background: #FAF7F2 !important;
    border-top: 2px solid #C8B89A !important;
    border-bottom: none !important;
    box-shadow: 0 20px 60px rgba(45, 42, 38, 0.13) !important;
    left: 50% !important;
    right: auto !important;
    width: min(100vw, var(--page-width, 1400px)) !important;
    transform: translateX(-50%) translateY(0) !important;
    padding: 0 !important;
    border-radius: 0 0 10px 10px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    animation: ann-menu-in 0.22s cubic-bezier(0.22, 0.61, 0.36, 1) forwards !important;
    z-index: 100 !important;
  }

  .mega-menu[open] .mega-menu__content.annvaya-mega-panel {
    opacity: 1 !important;
    transform: translateX(-50%) translateY(0) !important;
  }

  /* ══ Two-column split ════════════════════════════════════════════════ */
  .ann-mega-layout {
    display: grid;
    grid-template-columns: 1fr 272px;
    min-height: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════
     LEFT: Category navigation
  ══════════════════════════════════════════════════════════════════════ */
  .ann-mega-left {
    padding: 30px 40px 26px;
    border-right: 1px solid #E4D8C8;
    background: #FAF7F2;
  }

  /* — Top row: eyebrow + view-all — */
  .ann-mega-toprow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .ann-mega-eyebrow {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8B7355;
  }

  .ann-mega-viewall {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 500;
    color: #4A5740;
    text-decoration: none;
    transition: color 0.18s ease, gap 0.18s ease;
  }
  .ann-mega-viewall:hover { color: #2D2A26; gap: 8px; }
  .ann-mega-viewall .ann-arr {
    display: inline-block;
    transition: transform 0.18s ease;
    font-style: normal;
  }
  .ann-mega-viewall:hover .ann-arr { transform: translateX(3px); }

  /* — Category grid: 2 equal columns — */
  .ann-mega-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* — Individual category item — */
  .ann-mega-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 7px;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
    cursor: pointer;
  }
  .ann-mega-item:hover,
  .ann-mega-item:focus-visible { background: #EFE9DE; outline: none; }
  .ann-mega-item:focus-visible { box-shadow: 0 0 0 2px #5C6B4F; }

  /* 44px circle thumbnail */
  .ann-mega-item__thumb {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Earthy gradient fallbacks */
  .ann-mega-item__thumb.t1 { background: linear-gradient(140deg,#C09050 0%,#7A5825 100%); }
  .ann-mega-item__thumb.t2 { background: linear-gradient(140deg,#6A8F5A 0%,#3C5A2A 100%); }
  .ann-mega-item__thumb.t3 { background: linear-gradient(140deg,#5C8050 0%,#2D4F25 100%); }
  .ann-mega-item__thumb.t4 { background: linear-gradient(140deg,#C07848 0%,#7A3E20 100%); }
  .ann-mega-item__thumb.t5 { background: linear-gradient(140deg,#9A7E42 0%,#5A4820 100%); }
  .ann-mega-item__thumb.t6 { background: linear-gradient(140deg,#8A7090 0%,#4A3860 100%); }
  .ann-mega-item__thumb.t7 { background: linear-gradient(140deg,#5A6B50 0%,#2D3A28 100%); }
  .ann-mega-item__thumb.t8 { background: linear-gradient(140deg,#905050 0%,#4A2828 100%); }

  .ann-mega-item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .ann-mega-item:hover .ann-mega-item__thumb img { transform: scale(1.08); }

  /* Text block */
  .ann-mega-item__info { flex: 1; min-width: 0; }

  .ann-mega-item__name {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    color: #2D2A26;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ann-mega-item__desc {
    display: block;
    font-family: var(--font-body-family);
    font-size: 12px;
    color: #8A8078;
    margin-top: 3px;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Arrow — slides in on hover */
  .ann-mega-item__arrow {
    color: #5C6B4F;
    font-size: 14px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
    font-style: normal;
    line-height: 1;
  }
  .ann-mega-item:hover .ann-mega-item__arrow,
  .ann-mega-item:focus-visible .ann-mega-item__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ══ "Popular right now" strip ════════════════════════════════════ */
  .ann-mega-popular {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #E4D8C8;
  }

  .ann-mega-popular__label {
    display: block;
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8B7355;
    margin-bottom: 10px;
  }

  .ann-mega-popular__list {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ann-mega-popular__item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    padding: 8px 10px;
    border-radius: 7px;
    text-decoration: none;
    transition: background 0.16s ease;
  }
  .ann-mega-popular__item:hover { background: #EFE9DE; }
  .ann-mega-popular__item:focus-visible { outline: 2px solid #5C6B4F; outline-offset: 1px; border-radius: 7px; }

  .ann-mega-popular__img {
    width: 46px;
    height: 46px;
    border-radius: 7px;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(140deg,#6A8F5A 0%,#3C5A2A 100%);
  }
  .ann-mega-popular__img.ann-pop-img--2 {
    background: linear-gradient(140deg,#C09050 0%,#7A5825 100%);
  }
  .ann-mega-popular__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ann-mega-popular__title {
    display: block;
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 600;
    color: #2D2A26;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
  }

  .ann-mega-popular__sub {
    display: block;
    font-family: var(--font-body-family);
    font-size: 11px;
    color: #8A8078;
    margin-top: 2px;
  }

  /* ══ Trust strip ══════════════════════════════════════════════════ */
  .ann-mega-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid #E4D8C8;
  }

  .ann-mega-trust__item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body-family);
    font-size: 12px;
    color: #6A6258;
    padding-right: 22px;
    white-space: nowrap;
  }

  .ann-mega-trust__icon {
    width: 15px;
    height: 15px;
    color: #5C6B4F;
    flex-shrink: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════
     RIGHT: Brand promo panel
  ══════════════════════════════════════════════════════════════════════ */
  .ann-mega-promo {
    background: #2E3B33;
    padding: 30px 26px 26px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .ann-mega-promo::before {
    content: '';
    position: absolute;
    bottom: -70px;
    right: -55px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: rgba(255,255,255,0.025);
    pointer-events: none;
  }
  .ann-mega-promo::after {
    content: '';
    position: absolute;
    top: -35px;
    left: -25px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: rgba(200,184,154,0.05);
    pointer-events: none;
  }

  .ann-mega-promo__deco {
    position: absolute;
    bottom: 20px;
    right: -8px;
    width: 130px;
    height: auto;
    opacity: 0.045;
    pointer-events: none;
    color: #C8B89A;
  }

  .ann-mega-promo__badge {
    display: block;
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #A89878;
    margin-bottom: 14px;
  }

  .ann-mega-promo__headline {
    font-family: var(--font-heading-family);
    font-size: 24px;
    font-weight: 600;
    color: #F0EAD8;
    line-height: 1.22;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }

  .ann-mega-promo__sub {
    font-family: var(--font-body-family);
    font-size: 13px;
    color: rgba(240,234,216,0.58);
    line-height: 1.62;
    margin: 0;
  }

  .ann-mega-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: #C8B89A;
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(200,184,154,0.32);
    text-decoration: none;
    margin-top: 20px;
    align-self: flex-start;
    transition: color 0.18s ease, border-color 0.18s ease, gap 0.18s ease;
  }
  .ann-mega-promo__cta:hover {
    color: #E0CDA8;
    border-color: rgba(200,184,154,0.7);
    gap: 10px;
  }
  .ann-mega-promo__cta:focus-visible {
    outline: 2px solid #C8B89A;
    outline-offset: 3px;
  }
  .ann-mega-promo__cta .ann-arr {
    display: inline-block;
    transition: transform 0.18s ease;
    font-style: normal;
  }
  .ann-mega-promo__cta:hover .ann-arr { transform: translateX(3px); }

  .ann-mega-promo__promises {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ann-mega-promo__promise {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body-family);
    font-size: 12px;
    color: rgba(240,234,216,0.5);
    line-height: 1.3;
  }

  .ann-mega-promo__picon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: #7A9A78;
  }

  /* ══ Tablet (750–1023px) ══════════════════════════════════════════ */
  @media screen and (max-width: 1023px) {
    .ann-mega-layout { grid-template-columns: 1fr 230px; }
    .ann-mega-left   { padding: 24px 28px 22px; }
    .ann-mega-promo  { padding: 24px 20px 22px; }
    .ann-mega-items  { gap: 1px 4px; }
    .ann-mega-promo__headline { font-size: 20px; }
  }
</style>

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span {%- if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>

              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup annvaya-mega-panel"
                tabindex="-1"
              >
                <div class="ann-mega-layout">

                  <!-- ── LEFT: Category navigation ─────────────────── -->
                  <div class="ann-mega-left">

                    <!-- Top row -->
                    <div class="ann-mega-toprow">
                      <span class="ann-mega-eyebrow">{{ link.title | escape }}</span>
                      <a href="{{ link.url }}" class="ann-mega-viewall focus-inset">
                        View all products <i class="ann-arr" aria-hidden="true">→</i>
                      </a>
                    </div>

                    <!-- Category grid -->
                    <ul class="ann-mega-items" role="list">
                      {%- for childlink in link.links -%}
                        {%- liquid
                          assign cat_tagline = ''
                          case childlink.handle
                            when 'kitchen-essentials'
                              assign cat_tagline = 'Everyday nutrition for your kitchen'
                            when 'superfoods-wellness', 'superfoods', 'wellness'
                              assign cat_tagline = 'Natural powders for daily wellness'
                            when 'baby-food', 'baby-foods', 'baby'
                              assign cat_tagline = 'Wholesome nutrition for little ones'
                            when 'fruit-powders', 'fruits'
                              assign cat_tagline = 'Natural sweetness from real fruits'
                            when 'spice-blends', 'spices'
                              assign cat_tagline = 'Rich flavour from real ingredients'
                            when 'dried-fruits', 'dried-fruits-snacks', 'snacks'
                              assign cat_tagline = 'Naturally dried, simple and delicious'
                            when 'combo-packs', 'combos', 'bundles', 'gift-sets'
                              assign cat_tagline = 'Thoughtfully curated favourites'
                            when 'all'
                              assign cat_tagline = 'Browse the full range'
                          endcase
                          if cat_tagline == blank
                            assign cat_tagline = childlink.object.description | strip_html | truncate: 50, ''
                          endif
                          if cat_tagline == blank
                            assign cat_tagline = 'Explore the range'
                          endif
                        -%}
                        <li>
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{{ childlink.url }}"
                            class="ann-mega-item focus-inset{% if childlink.current %} mega-menu__link--active{% endif %}"
                            {% if childlink.current %}aria-current="page"{% endif %}
                          >
                            <div class="ann-mega-item__thumb t{{ forloop.index }}" aria-hidden="true">
                              {%- if childlink.object.featured_image != blank -%}
                                <img
                                  src="{{ childlink.object.featured_image | image_url: width: 80 }}"
                                  alt="{{ childlink.object.featured_image.alt | default: childlink.title | escape }}"
                                  width="40"
                                  height="40"
                                  loading="lazy"
                                >
                              {%- endif -%}
                            </div>
                            <div class="ann-mega-item__info">
                              <span class="ann-mega-item__name">{{ childlink.title | escape }}</span>
                              <span class="ann-mega-item__desc">{{ cat_tagline }}</span>
                            </div>
                            <i class="ann-mega-item__arrow" aria-hidden="true">→</i>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>

                    <!-- Popular right now -->
                    {%- liquid
                      assign pop1 = collections['superfoods-wellness'].products.first
                      assign pop2 = collections['baby-food'].products.first
                    -%}
                    {%- if pop1 or pop2 -%}
                    <div class="ann-mega-popular" aria-label="Popular products">
                      <span class="ann-mega-popular__label">Popular right now</span>
                      <ul class="ann-mega-popular__list" role="list">
                        {%- if pop1 -%}
                        <li>
                          <a href="{{ pop1.url }}" class="ann-mega-popular__item focus-inset">
                            <div class="ann-mega-popular__img" aria-hidden="true">
                              {%- if pop1.featured_image != blank -%}
                                <img
                                  src="{{ pop1.featured_image | image_url: width: 88 }}"
                                  alt="{{ pop1.featured_image.alt | default: pop1.title | escape }}"
                                  width="44"
                                  height="44"
                                  loading="lazy"
                                >
                              {%- endif -%}
                            </div>
                            <div>
                              <span class="ann-mega-popular__title">{{ pop1.title | truncate: 26 }}</span>
                              <span class="ann-mega-popular__sub">Nature's everyday superfood</span>
                            </div>
                          </a>
                        </li>
                        {%- endif -%}
                        {%- if pop2 -%}
                        <li>
                          <a href="{{ pop2.url }}" class="ann-mega-popular__item focus-inset">
                            <div class="ann-mega-popular__img ann-pop-img--2" aria-hidden="true">
                              {%- if pop2.featured_image != blank -%}
                                <img
                                  src="{{ pop2.featured_image | image_url: width: 88 }}"
                                  alt="{{ pop2.featured_image.alt | default: pop2.title | escape }}"
                                  width="44"
                                  height="44"
                                  loading="lazy"
                                >
                              {%- endif -%}
                            </div>
                            <div>
                              <span class="ann-mega-popular__title">{{ pop2.title | truncate: 26 }}</span>
                              <span class="ann-mega-popular__sub">Wholesome nutrition for little ones</span>
                            </div>
                          </a>
                        </li>
                        {%- endif -%}
                      </ul>
                    </div>
                    {%- endif -%}

                    <!-- Trust strip -->
                    <div class="ann-mega-trust" role="list" aria-label="Brand assurances">
                      <div class="ann-mega-trust__item" role="listitem">
                        <!-- Leaf: 100% Natural -->
                        <svg class="ann-mega-trust__icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <path d="M2.5 11.5 C2.5 11.5 3.5 4 11 2 C11 2 10.5 9.5 2.5 11.5Z"/>
                          <path d="M2.5 11.5 L7 6.5"/>
                        </svg>
                        100% Natural
                      </div>
                      <div class="ann-mega-trust__item" role="listitem">
                        <!-- Water drop: No Preservatives / Pure -->
                        <svg class="ann-mega-trust__icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <path d="M7 1.5 C5.5 4 3 6.5 3 8.5 A4 4 0 0 0 11 8.5 C11 6.5 8.5 4 7 1.5Z"/>
                        </svg>
                        No Preservatives
                      </div>
                      <div class="ann-mega-trust__item" role="listitem">
                        <!-- Shield: FSSAI Licensed -->
                        <svg class="ann-mega-trust__icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <path d="M7 1.5 L12 3.8 V8 C12 10.5 7 12.5 7 12.5 C7 12.5 2 10.5 2 8 V3.8 Z"/>
                          <path d="M4.8 7 L6.2 8.5 L9.2 5.5"/>
                        </svg>
                        FSSAI Licensed
                      </div>
                      <div class="ann-mega-trust__item" role="listitem">
                        <!-- Delivery: Free Shipping -->
                        <svg class="ann-mega-trust__icon" viewBox="0 0 16 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <rect x="1" y="3.5" width="9" height="7" rx="1"/>
                          <path d="M10 5.5 H13 L14.5 8 V10.5 H10 Z"/>
                          <circle cx="3.5" cy="10.5" r="1.3" fill="currentColor" stroke="none"/>
                          <circle cx="12" cy="10.5" r="1.3" fill="currentColor" stroke="none"/>
                        </svg>
                        Free Shipping ₹499+
                      </div>
                    </div>

                  </div><!-- /ann-mega-left -->

                  <!-- ── RIGHT: Brand promo panel ─────────────────── -->
                  <div class="ann-mega-promo">

                    <!-- Decorative botanical leaf shape (very faint) -->
                    <svg class="ann-mega-promo__deco" viewBox="0 0 120 180" fill="none" aria-hidden="true" focusable="false">
                      <path d="M60 170 C60 170 10 120 10 70 C10 20 60 5 60 5 C60 5 110 20 110 70 C110 120 60 170 60 170Z" fill="currentColor"/>
                      <path d="M60 5 L60 170" stroke="currentColor" stroke-width="2"/>
                      <path d="M60 60 Q40 50 25 35" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M60 80 Q80 70 95 55" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M60 100 Q38 92 22 80" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M60 120 Q82 112 96 100" stroke="currentColor" stroke-width="1.5"/>
                    </svg>

                    <span class="ann-mega-promo__badge">Purely from Nature</span>

                    <h3 class="ann-mega-promo__headline">
                      Good food starts<br>with real ingredients.
                    </h3>

                    <p class="ann-mega-promo__sub">
                      Thoughtfully crafted natural foods, from everyday nutrition to wholesome food for little ones.
                    </p>

                    <a href="/pages/about" class="ann-mega-promo__cta">
                      Explore our story <i class="ann-arr" aria-hidden="true">→</i>
                    </a>

                    <div class="ann-mega-promo__promises" aria-label="Brand promises">

                      <div class="ann-mega-promo__promise">
                        <!-- Leaf: Naturally made -->
