{% comment %}
  ANNVAYA — Premium Header Dropdown / Mega Menu
  Full-width fixed panel. Collection cards with images.
{% endcomment %}

<style>
  /* ── Base: all dropdowns ── */
  details[id^="Details-HeaderMenu-"] {
    position: static;
  }

  .annvaya-dd-submenu {
    position: fixed;
    top: var(--header-height, 80px);
    left: 50%;
    transform: translateX(-50%);
    width: min(98vw, var(--page-width, 1400px));
    z-index: 300;
    background: #fff;
    border: 1px solid #E8E0D4;
    border-top: 3px solid #5C6B4F;
    border-radius: 0 0 20px 20px;
    box-shadow: 0 24px 70px rgba(45, 42, 38, 0.20);
    padding: 36px 40px 32px;
    margin: 0;
    list-style: none;
    opacity: 0;
    animation: annvaya-dd-in 0.22s ease forwards;
    box-sizing: border-box;
  }

  @keyframes annvaya-dd-in {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Inner max-width container */
  .annvaya-dd-inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
  }

  /* Top row: eyebrow + view-all link */
  .annvaya-dd-toprow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .annvaya-dd-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #D4A76A;
  }

  .annvaya-dd-viewall {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4A5740;
    text-decoration: none;
    border-bottom: 1.5px solid #4A5740;
    padding-bottom: 1px;
    transition: gap 0.18s ease, color 0.18s ease;
  }
  .annvaya-dd-viewall:hover { color: #2D2A26; gap: 9px; }

  /* ── Collection card grid ── */
  .annvaya-dd-grid {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* columns set per data-cols attribute */
  }
  .annvaya-dd-grid[data-cols="1"] { grid-template-columns: repeat(1, 1fr); }
  .annvaya-dd-grid[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
  .annvaya-dd-grid[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
  .annvaya-dd-grid[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  .annvaya-dd-grid[data-cols="5"] { grid-template-columns: repeat(5, 1fr); }
  .annvaya-dd-grid[data-cols="6"] { grid-template-columns: repeat(3, 1fr); }

  .annvaya-dd-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #FAF7F2;
    border: 1.5px solid #E8E0D4;
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.22s, box-shadow 0.22s;
  }
  .annvaya-dd-card:hover {
    border-color: #5C6B4F;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(45, 42, 38, 0.14);
  }

  .annvaya-dd-card__img {
    width: 100%;
    height: 210px;
    overflow: hidden;
    background: linear-gradient(135deg, #5C6B4F 0%, #2D2A26 100%);
    position: relative;
  }
  /* per-category placeholder gradients */
  .annvaya-dd-card__img.c1 { background: linear-gradient(135deg, #8B6914, #5C4A1E); }
  .annvaya-dd-card__img.c2 { background: linear-gradient(135deg, #6B9E5B, #3A5730); }
  .annvaya-dd-card__img.c3 { background: linear-gradient(135deg, #3D7B35, #1E4020); }
  .annvaya-dd-card__img.c4 { background: linear-gradient(135deg, #B05820, #7A3210); }
  .annvaya-dd-card__img.c5 { background: linear-gradient(135deg, #5A6B8A, #2D3A50); }

  .annvaya-dd-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .annvaya-dd-card:hover .annvaya-dd-card__img img {
    transform: scale(1.09);
  }

  /* Emoji badge overlay */
  .annvaya-dd-card__emoji {
    position: absolute;
    top: 10px;
    left: 12px;
    font-size: 1.5rem;
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  .annvaya-dd-card__body {
    padding: 16px 18px 18px;
  }

  .annvaya-dd-card__title {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: #2D2A26;
    margin: 0 0 5px;
    line-height: 1.3;
  }

  .annvaya-dd-card__desc {
    display: block;
    font-size: 0.82rem;
    color: #7A7570;
    line-height: 1.5;
    margin: 0 0 12px;
  }

  .annvaya-dd-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #5C6B4F;
    transition: gap 0.18s;
  }
  .annvaya-dd-card:hover .annvaya-dd-card__cta { gap: 9px; }

  /* Bottom promo strip */
  .annvaya-dd-strip {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #E8E0D4;
  }
  .annvaya-dd-strip__item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    color: #4A4540;
  }
  .annvaya-dd-strip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #5C6B4F;
    flex-shrink: 0;
  }

  /* ── Plain list dropdown (narrower) ── */
  .annvaya-dd-submenu--plain {
    padding: 20px 40px;
  }
  .annvaya-dd-plain-list {
    max-width: 320px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .annvaya-dd-plain-list li { border-bottom: 1px solid #F0EBE3; }
  .annvaya-dd-plain-list li:last-child { border-bottom: none; }
  .annvaya-dd-plain-link {
    display: block;
    font-size: 0.95rem;
    color: #4A4540;
    padding: 10px 0;
    text-decoration: none;
    transition: color 0.15s, padding-left 0.15s;
  }
  .annvaya-dd-plain-link:hover { color: #5C6B4F; padding-left: 6px; }
</style>

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span {%- if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>

              {%- assign has_collections = false -%}
              {%- for childlink in link.links -%}
                {%- if childlink.type == 'collection_link' -%}
                  {%- assign has_collections = true -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if has_collections -%}

                {%- assign child_count = link.links.size -%}
                {%- assign col_count = child_count -%}
                {%- if child_count > 5 -%}{%- assign col_count = 4 -%}{%- endif -%}

                <ul
                  id="HeaderMenu-MenuList-{{ forloop.index }}"
                  class="annvaya-dd-submenu global-settings-popup"
                  role="list"
                  tabindex="-1"
                >
                  <li style="list-style:none;padding:0;margin:0;">
                    <div class="annvaya-dd-inner">

                      <div class="annvaya-dd-toprow">
                        <span class="annvaya-dd-eyebrow">{{ link.title | escape }}</span>
                        <a href="{{ link.url }}" class="annvaya-dd-viewall">
                          View all <span aria-hidden="true">→</span>
                        </a>
                      </div>

                      <ul class="annvaya-dd-grid" data-cols="{{ col_count }}" role="list">
                        {%- for childlink in link.links -%}
                          {%- assign ci = forloop.index | append: '' -%}
                          <li style="list-style:none;padding:0;margin:0;">
                            <a
                              id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="annvaya-dd-card focus-inset{% if childlink.current %} list-menu__item--active{% endif %}"
                              {% if childlink.current %}aria-current="page"{% endif %}
                            >
                              <div class="annvaya-dd-card__img c{{ forloop.index }}">
                                {%- if childlink.object.featured_image != blank -%}
                                  <img
                                    src="{{ childlink.object.featured_image | image_url: width: 600 }}"
                                    alt="{{ childlink.object.featured_image.alt | default: childlink.title | escape }}"
                                    width="600"
                                    height="180"
                                    loading="lazy"
                                  >
                                {%- endif -%}
                              </div>
                              <div class="annvaya-dd-card__body">
                                <span class="annvaya-dd-card__title">{{ childlink.title | escape }}</span>
                                {%- if childlink.object.description != blank -%}
                                  <span class="annvaya-dd-card__desc">{{ childlink.object.description | strip_html | truncate: 55 }}</span>
                                {%- elsif childlink.object.products_count > 0 -%}
                                  <span class="annvaya-dd-card__desc">{{ childlink.object.products_count }} products</span>
                                {%- endif -%}
                                <span class="annvaya-dd-card__cta">Shop <span aria-hidden="true">→</span></span>
                              </div>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>

                      <div class="annvaya-dd-strip">
                        <div class="annvaya-dd-strip__item">
                          <span class="annvaya-dd-strip__dot"></span>
                          100% Natural
                        </div>
                        <div class="annvaya-dd-strip__item">
                          <span class="annvaya-dd-strip__dot"></span>
                          No Preservatives
                        </div>
                        <div class="annvaya-dd-strip__item">
                          <span class="annvaya-dd-strip__dot"></span>
                          FSSAI Licensed
                        </div>
                        <div class="annvaya-dd-strip__item">
                          <span class="annvaya-dd-strip__dot"></span>
                          Free shipping on orders ₹499+
                        </div>
                      </div>

                    </div>
                  </li>
                </ul>

              {%- else -%}

                <ul
                  id="HeaderMenu-MenuList-{{ forloop.index }}"
                  class="annvaya-dd-submenu annvaya-dd-submenu--plain global-settings-popup"
                  role="list"
                  tabindex="-1"
                >
                  <li style="list-style:none;padding:0;margin:0;">
                    <div class="annvaya-dd-inner">
                      <span class="annvaya-dd-eyebrow" style="display:block;margin-bottom:14px;">{{ link.title | escape }}</span>
                      <ul class="annvaya-dd-plain-list" role="list">
                        {%- for childlink in link.links -%}
                          <li>
                            <a
                              id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="annvaya-dd-plain-link focus-inset{% if childlink.current %} list-menu__item--active{% endif %}"
                              {% if childlink.current %}aria-current="page"{% endif %}
                            >
                              {{ childlink.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </li>
                </ul>

              {%- endif -%}
            </details>
          </header-menu>

        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span {%- if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
